[Unit]
Description=Lianum PAEG Ethereum Sepolia, Bitcoin testnet and Solana devnet
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/lianum-testnet-signer/paeg-public-v4/operator.json

[Service]
Type=simple
User=lianum-testnet-signer
Group=lianum-testnet-signer
UMask=0077
WorkingDirectory=/var/lib/lianum-paeg-public/prover-work-v5
ExecStart=/var/lib/lianum-paeg-public/current/candidate/resources/tools/node --max-old-space-size=384 /var/lib/lianum-paeg-public/current/infra/run-public-operator-v4.mjs
KillMode=process
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=900
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lianum-paeg-public /var/lib/lianum-testnet-signer/paeg-provider-v1 /var/lib/lianum-testnet-signer/paeg-public-v4
MemoryMax=48G
CPUAccounting=yes
MemoryAccounting=yes
TasksMax=256
LimitNOFILE=65536
Environment=LANG=C.UTF-8 PATH=/usr/bin:/bin
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_TLS_REJECT_UNAUTHORIZED LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PYTHONHOME
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
