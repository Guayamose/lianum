# Reviewed for the installed Caddy 2.6.2. Apply only after the original
# motor is ready and its PUBLIC transport certificate has been installed.
api.lianum.oryontechnology.com {
	@missingPairing {
		path /v1/mobile/paged-owner/*
		not header X-Lianum-Paged-Pairing-Id *
	}
	handle @missingPairing {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"error":"PAGED_PAIRING_REQUIRED"}` 403
	}

	@engine path /v1/mobile/paged-owner/* /v1/mobile/external-flat-share/*
	handle @engine {
		request_body {
			max_size 4194304
		}
		reverse_proxy https://10.71.0.3:9445 {
			lb_try_duration 0s
			transport http {
				dial_timeout 3s
				response_header_timeout 900s
				tls_timeout 5s
				tls_trusted_ca_certs /etc/caddy/lianum-paeg-transport.pem
			}
		}
	}

	handle {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8788
	}
}
