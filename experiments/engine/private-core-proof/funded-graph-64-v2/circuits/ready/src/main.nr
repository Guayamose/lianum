use profile64::{graph,framing};
use graph_support::sha256::words_to_bytes;
use native_support::{receipt,state};
fn node_hash(n:graph::Node,slot:u8)->[u8;32]{framing::node(slot,n.id_digest,n.chain_domain,n.evidence_policy,n.action_commitment,n.payout_commitment,n.local_commitment,n.dispatch_id,n.receipt_key_commitment,n.receipt_rho,n.salt,n.dependency_mask)}
fn member(cm:[u8;32],path:[[u8;32];6],slot:u32,root:[u8;32]){assert(slot<64);let mut value=cm;for d in 0..6{value=if ((slot>>d)&1)==0{framing::graph_tree(value,path[d])}else{framing::graph_tree(path[d],value)};}assert(value==root);}
fn main(domain_commitment:pub [u32;8],authorization_root:pub [u32;8],graph_root:pub [u32;8],local_commitment:pub [u32;8],dispatch_id:pub [u32;8],evidence_state:pub [u32;8],ready_commitment:pub [u32;8],valid_from:pub u64,valid_until:pub u64,scope:[u8;32],policy:[u8;32],asset:[u8;32],hub_domain:[u8;32],registry_commitment:[u8;32],slot:u32,node:graph::Node,siblings:[[u8;32];6],predecessors:[graph::Node;64],predecessor_siblings:[[[u8;32];6];64],state_opening:state::EvidenceState,receipts:[receipt::ReceiptRead;64],receipt_siblings:[[[u8;32];6];64],receipt_indices:[u32;64],revoked_entries:[[u8;32];64]){
 assert(framing::domain(scope,policy,asset,hub_domain,registry_commitment)==words_to_bytes(domain_commitment));assert(slot<64);assert(valid_from<valid_until);assert(node.local_commitment==words_to_bytes(local_commitment));assert(node.dispatch_id==words_to_bytes(dispatch_id));
 let leaf=node_hash(node,slot as u8);member(leaf,siblings,slot,words_to_bytes(graph_root));assert(state_opening.hub_domain==hub_domain);assert(state_opening.registry_commitment==registry_commitment);assert(state::evidence_state_digest(state_opening)==words_to_bytes(evidence_state));assert(state::bounded_list_digest(0x32,hub_domain,revoked_entries,state_opening.revoked_count)==state_opening.revoked_digest);
 if slot==0{assert(node.dependency_mask==0);}else{assert(node.dependency_mask<(1 as u64 << slot));}
 for i in 0..64{if ((node.dependency_mask >> i)&1)==1{
  assert(i<slot);let n=predecessors[i];member(node_hash(n,i as u8),predecessor_siblings[i],i,words_to_bytes(graph_root));let r=receipts[i];assert(r.hub_domain==hub_domain);assert(r.registry_commitment==registry_commitment);assert(r.scope==scope);assert(r.policy==policy);assert(r.local_commitment==n.local_commitment);assert(r.dispatch_id==n.dispatch_id);assert(r.chain_domain==n.chain_domain);assert(r.evidence_policy==n.evidence_policy);assert(r.action_commitment==n.action_commitment);assert(r.payout_commitment==n.payout_commitment);assert(r.receipt_key_commitment==n.receipt_key_commitment);assert(r.receipt_rho==n.receipt_rho);assert(r.valid_from<=valid_from);assert(valid_until<=r.valid_until);assert(receipt_indices[i]<state_opening.receipt_count);state::membership(receipt::receipt_commitment(r),receipt_siblings[i],receipt_indices[i],state_opening.receipt_root);for j in 0..64{if j<state_opening.revoked_count{assert(r.global_effect_id!=revoked_entries[j]);}}
 }else{graph::empty_node(predecessors[i]);assert(predecessor_siblings[i]==[[0;32];6]);profile64::receipt_helpers::empty_receipt(receipts[i]);assert(receipt_siblings[i]==[[0;32];6]);assert(receipt_indices[i]==0);}}
 assert(framing::ready(words_to_bytes(authorization_root),leaf,words_to_bytes(evidence_state),node.dispatch_id,valid_from,valid_until)==words_to_bytes(ready_commitment));
}
