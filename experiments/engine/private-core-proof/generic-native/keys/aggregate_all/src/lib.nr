pub global VK_HASH: Field = 3241624635929926170499740704914963965686156148777466047278757677099331362522;

pub fn verify(proof: [Field; 458], inputs: [Field; 98]) {
    bb_honk_verifier::verify_honk_proof(VK, proof, inputs, VK_HASH);
    for i in 0..96 {
        let value = inputs[i] as u32;
        assert(value as Field == inputs[i]);
    }
    for i in 96..98 {
        let value = inputs[i] as u64;
        assert(value as Field == inputs[i]);
    }
}
