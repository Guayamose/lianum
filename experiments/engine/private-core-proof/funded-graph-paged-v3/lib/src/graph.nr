// New V3 graph byte relation. Original PC23, nullifier, secp256k1 and
// native receipt codecs are pure dependencies; no original VK is re-labelled.
use crate::framing;
use funding_support::framing as original_note;
use graph_support::sha256::{sha256,words_to_bytes};
pub struct Statement {pub scope:[u8;32],pub policy:[u8;32],pub asset:[u8;32],pub hub_domain:[u8;32],pub registry_commitment:[u8;32],pub operation_id:[u8;32],pub context:[u8;32],pub pages_root:[u8;32],pub nodes_root:[u8;32],pub outputs_root:[u8;32],pub pages_commitment:[u8;32],pub nodes_commitment:[u8;32],pub outputs_commitment:[u8;32],pub input_commitment:[u8;32],pub input_nullifier:[u8;32],pub change_commitment:[u8;32],pub recovery_commitment:[u8;32],pub reserve_commitment:[u8;32],pub reserve_nullifier:[u8;32],pub authorization_root:[u8;32],pub pages:u64,pub nodes:u64,pub budget:u64,pub funding_not_before:u64,pub funding_valid_until:u64,pub settle_before:u64,}
pub struct Note {pub rho:[u8;32],pub key_x:[u8;32],pub key_y:[u8;32],pub value:u64,pub secret:[u8;32]}
pub struct Node {pub ordinal:u64,pub id_digest:[u8;32],pub chain_domain:[u8;32],pub evidence_policy:[u8;32],pub action_commitment:[u8;32],pub local_commitment:[u8;32],pub dispatch_id:[u8;32],pub receipt_key_commitment:[u8;32],pub receipt_rho:[u8;32],pub dependencies:[u8;32],pub payout_commitment:[u8;32],pub dependency_count:u64}
pub struct Page {pub index:u64,pub first:u64,pub count:u8,pub salt:[u8;32],pub previous_nodes:[u8;32],pub next_nodes:[u8;32],pub previous_outputs:[u8;32],pub next_outputs:[u8;32]}
pub struct Reserve {pub statement:Statement,pub input_note:Note,pub change_note:Note,pub recovery_note:Note,pub graph_salt:[u8;32],pub reservation_nonce:[u8;32],pub reserve_secret:[u8;32],pub owner_signature:[u8;64]}
pub fn domain(s:Statement)->[u8;32]{framing::domain(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment)}
pub fn authorization(s:Statement)->[u8;32]{framing::authorization(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.operation_id,s.context,s.pages_root,s.nodes_root,s.outputs_root,s.pages_commitment,s.nodes_commitment,s.outputs_commitment,s.input_commitment,s.input_nullifier,s.change_commitment,s.recovery_commitment,s.reserve_commitment,s.reserve_nullifier,s.pages,s.nodes,s.budget,s.funding_not_before,s.funding_valid_until,s.settle_before)}
pub fn assert_statement(s:Statement){assert(s.scope!=[0;32]);assert(s.policy!=[0;32]);assert(s.asset!=[0;32]);assert(s.hub_domain!=[0;32]);assert(s.registry_commitment!=[0;32]);assert(s.operation_id!=[0;32]);assert(s.pages>0);assert(s.nodes>=s.pages);assert((s.nodes as u128)<=(s.pages as u128)*64);assert(s.budget>=s.nodes);assert(s.funding_not_before<s.funding_valid_until);assert(s.funding_valid_until<=s.settle_before);assert(authorization(s)==s.authorization_root);assert(s.authorization_root!=[0;32]);}
pub fn note_commitment(s:Statement,n:Note)->[u8;32]{assert(n.value>0);original_note::legacy_balance(s.scope,s.policy,n.rho,n.key_x,n.key_y,n.value,n.secret)}
pub fn node_digest(n:Node)->[u8;32]{assert(n.id_digest!=[0;32]);assert(n.chain_domain!=[0;32]);assert(n.evidence_policy!=[0;32]);assert(n.action_commitment!=[0;32]);assert(n.local_commitment!=[0;32]);assert(n.dispatch_id!=[0;32]);assert(n.receipt_key_commitment!=[0;32]);assert(n.receipt_rho!=[0;32]);assert(n.payout_commitment!=[0;32]);assert(n.dependency_count<=n.ordinal);framing::node(n.ordinal,n.id_digest,n.chain_domain,n.evidence_policy,n.action_commitment,n.local_commitment,n.dispatch_id,n.receipt_key_commitment,n.receipt_rho,n.dependencies,n.payout_commitment,n.dependency_count)}
pub fn page_digest(s:Statement,p:Page)->[u8;32]{assert(p.count>0);assert(p.count<=64);assert(p.index<s.pages);assert((p.first as u128)+(p.count as u128)<=s.nodes as u128);assert(p.salt!=[0;32]);framing::page(s.context,p.index,p.first,p.count,p.salt,p.previous_nodes,p.next_nodes,p.previous_outputs,p.next_outputs)}
pub fn branch(kind:u8,left:[u8;32],right:[u8;32])->[u8;32]{assert(kind<5);if kind==0{framing::pages_branch(left,right)}else if kind==1{framing::nodes_branch(left,right)}else if kind==2{framing::outputs_branch(left,right)}else if kind==3{framing::frontier_branch(left,right)}else{framing::admitted_branch(left,right)}}
pub fn empty_leaf(kind:u8)->[u8;32]{assert(kind<5);if kind==0{framing::pages_empty()}else if kind==1{framing::nodes_empty()}else if kind==2{framing::outputs_empty()}else if kind==3{framing::frontier_empty()}else{framing::admitted_empty()}}
pub fn empty_root(kind:u8)->[u8;32]{let mut value=empty_leaf(kind);for _i in 0..64{value=branch(kind,value,value);}value}
pub fn sparse_root(kind:u8,leaf:[u8;32],ordinal:u64,siblings:[[u8;32];64])->[u8;32]{let mut value=leaf;for d in 0..64{value=if ((ordinal>>(d as u64))&1)==0{branch(kind,value,siblings[d])}else{branch(kind,siblings[d],value)};}value}
pub fn member(kind:u8,leaf:[u8;32],ordinal:u64,siblings:[[u8;32];64],root:[u8;32]){assert(leaf!=empty_leaf(kind));assert(sparse_root(kind,leaf,ordinal,siblings)==root);}
pub fn source_membership(cm:[u8;32],siblings:[[u8;32];8],index:u32,root:[u8;32]){assert(index<256);let mut value=cm;for d in 0..8{let mut message:[u8;65]=[0;65];message[0]=1;let left=if ((index>>d)&1)==0{value}else{siblings[d]};let right=if ((index>>d)&1)==0{siblings[d]}else{value};for j in 0..32{message[1+j]=left[j];message[33+j]=right[j];}value=sha256::<65,128>(message);}assert(value==root);}
pub fn assert_reserve(w:Reserve){let s=w.statement;assert_statement(s);assert(w.reservation_nonce!=[0;32]);assert(w.reserve_secret!=[0;32]);assert(w.graph_salt!=[0;32]);assert(s.context==framing::context(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.operation_id,w.graph_salt));assert(note_commitment(s,w.input_note)==s.input_commitment);assert(original_note::legacy_nullifier(s.scope,s.input_commitment,w.input_note.secret)==s.input_nullifier);assert((w.input_note.value as u128)==(s.budget as u128)+(w.change_note.value as u128));assert(w.recovery_note.value==s.budget);assert(note_commitment(s,w.recovery_note)==s.recovery_commitment);if w.change_note.value>0{assert(note_commitment(s,w.change_note)==s.change_commitment);}else{assert(w.change_note.rho==[0;32]);assert(w.change_note.key_x==[0;32]);assert(w.change_note.key_y==[0;32]);assert(w.change_note.secret==[0;32]);assert(s.change_commitment==framing::empty_change(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.input_nullifier,s.operation_id,w.reservation_nonce));}assert(s.reserve_commitment==framing::reserve(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.operation_id,w.reservation_nonce,s.pages_root,s.nodes_root,s.outputs_root,s.budget,s.recovery_commitment,w.reserve_secret));assert(original_note::legacy_nullifier(s.scope,s.reserve_commitment,w.reserve_secret)==s.reserve_nullifier);assert(s.input_commitment!=s.change_commitment);assert(s.input_commitment!=s.recovery_commitment);assert(s.input_commitment!=s.reserve_commitment);assert(s.change_commitment!=s.recovery_commitment);assert(s.change_commitment!=s.reserve_commitment);assert(s.recovery_commitment!=s.reserve_commitment);assert(s.input_nullifier!=s.reserve_nullifier);original64::native_statement::assert_signature(w.input_note.key_x,w.input_note.key_y,w.owner_signature,framing::owner(s.authorization_root));}
pub fn receipt_matches(s:Statement,n:Node,r:native_support::receipt::ReceiptRead){assert(r.hub_domain==s.hub_domain);assert(r.registry_commitment==s.registry_commitment);assert(r.scope==s.scope);assert(r.policy==s.policy);assert(r.local_commitment==n.local_commitment);assert(r.dispatch_id==n.dispatch_id);assert(r.chain_domain==n.chain_domain);assert(r.evidence_policy==n.evidence_policy);assert(r.action_commitment==n.action_commitment);assert(r.payout_commitment==n.payout_commitment);assert(r.receipt_key_commitment==n.receipt_key_commitment);assert(r.receipt_rho==n.receipt_rho);}

pub fn receipt_index(cm:[u8;32])->u64{let mut index:u64=0;for i in 24..32{index=(index<<8)+(cm[i] as u64);}index}
