// New V3 admission requires SAME original proved Ready in the V3 consumer.
// Reuses only original rule/native-effect/PC23/signature/quorum algorithms.
use paged::{framing,graph,progress};
use original64::native_statement as original;
use native_support::{capsule,capsule_framing,receipt,state,quorum};
fn main(public_inputs:pub [Field;85],statement:graph::Statement,node:graph::Node,node_siblings:[[u8;32];64],ready_progress:progress::Progress,ready_blinding:[u8;32],progress_blinding:[u8;32],ready_from:u64,ready_until:u64,
 registry:quorum::Registry,rule:original::Rule,rule_siblings:[[u8;32];3],rule_index:u8,
 action:capsule::Action,effect:receipt::NativeEffect,opening:receipt::ReceiptRead,observation:original::Observation,
 provider_key_x:[u8;32],provider_key_y:[u8;32],dispatch_signed_at:u64,dispatch_signature:[u8;64],delivery_risk_salt:[u8;32],attester_indexes:[u8;3],attester_signatures:[[u8;64];3]){
 let p=public_inputs;let s=statement;graph::assert_statement(s);assert(graph::domain(s)==progress::digest(p,0));assert(s.authorization_root==progress::digest(p,8));let node_cm=graph::node_digest(node);graph::member(1,node_cm,node.ordinal,node_siblings,s.nodes_commitment);assert(node_cm==progress::digest(p,16));assert(node.local_commitment==progress::digest(p,32));assert(node.dispatch_id==progress::digest(p,40));assert(ready_from<ready_until);assert(ready_until<=s.settle_before);assert(ready_progress.next_node==node.ordinal);assert(ready_progress.active_node_digest==node_cm);assert(ready_progress.active_dependency_root==node.dependencies);assert(ready_progress.active_dependency_count==node.dependency_count);assert(ready_progress.next_edge==node.dependency_count);assert(ready_progress.edge_chain==node.dependencies);assert(ready_progress.revocation_sequence==progress::scalar(p,72));assert(ready_from>=ready_progress.max_receipt_from);assert(ready_until<=ready_progress.min_receipt_until);let current_commitment=progress::commitment(graph::domain(s),s.authorization_root,s.reserve_nullifier,ready_progress,progress_blinding);assert(current_commitment==progress::digest(p,77));let ready=progress::ready(graph::domain(s),s.authorization_root,s.reserve_nullifier,current_commitment,ready_blinding);assert(ready==progress::digest(p,24));
 assert(registry.hub_domain==s.hub_domain);assert(quorum::registry_commitment(registry)==s.registry_commitment);original::assert_rule(rule);let rule_cm=original::rule_commitment(rule);assert(rule_index<8);let mut rule_root=rule_cm;for d in 0..3{rule_root=if (((rule_index as u32)>>d)&1)==0{state::node_hash(rule_root,rule_siblings[d])}else{state::node_hash(rule_siblings[d],rule_root)};}assert(rule_root==registry.rules_root);assert(rule_cm==node.evidence_policy);assert(original::chain_domain(rule)==node.chain_domain);
 assert(effect.family==rule.family);assert(effect.genesis==rule.genesis);assert(effect.asset==rule.asset);let gid=receipt::native_global_effect_id(effect);assert(gid==progress::digest(p,56));assert(framing::admission_nullifier(s.hub_domain,gid)==progress::digest(p,64));
 capsule::assert_action(action);assert(action.chain_domain==node.chain_domain);assert(capsule_framing::native_transfer_action(action)==node.action_commitment);assert(original::provider_identity(provider_key_x,provider_key_y)==action.signer_identity);assert(action.receipt_key_commitment==node.receipt_key_commitment);assert(action.receipt_rho==node.receipt_rho);assert(delivery_risk_salt!=[0;32]);assert(action.delivery_risk_commitment==original64::framing::delivery_risk(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,action.chain_domain,action.source_commitment,action.destination_commitment,action.amount,node.payout_commitment,action.settle_before,delivery_risk_salt));
 assert(observation.source_commitment==action.source_commitment);assert(observation.destination_commitment==action.destination_commitment);assert(observation.amount==action.amount);assert(observation.custody_kind==action.custody_kind);assert(observation.custody_commitment==action.custody_commitment);assert(observation.block_id!=[0;32]);assert(observation.state_commitment!=[0;32]);assert(observation.finality_kind==rule.finality_kind);assert(observation.confirmations>=rule.minimum_confirmations);assert(observation.evidence_from<=observation.observed_at);assert(observation.observed_at<observation.evidence_until);assert(observation.evidence_until-observation.evidence_from<=rule.maximum_evidence_lifetime);assert(observation.evidence_until<=action.settle_before);assert(action.settle_before<=s.settle_before);
 let admission_from=progress::scalar(p,73);let admission_until=progress::scalar(p,74);assert(admission_from<admission_until);assert(ready_from<=admission_from);assert(admission_until<=ready_until);assert(observation.evidence_from<=admission_from);assert(admission_until<=observation.evidence_until);if admission_from<observation.observed_at{assert(observation.observed_at-admission_from<=rule.maximum_clock_skew);}if observation.observed_at<dispatch_signed_at{assert(dispatch_signed_at-observation.observed_at<=rule.maximum_clock_skew);}
 graph::receipt_matches(s,node,opening);assert(opening.global_effect_id==gid);assert(opening.valid_from==observation.evidence_from);assert(opening.valid_until==observation.evidence_until);assert(opening.valid_from==progress::scalar(p,75));assert(opening.valid_until==progress::scalar(p,76));let cm=receipt::receipt_commitment(opening);assert(cm==progress::digest(p,48));assert(ready_from<=dispatch_signed_at);assert(dispatch_signed_at<ready_until);assert(action.execution_from<=dispatch_signed_at);assert(dispatch_signed_at<action.execution_until);
 let dispatch=original::dispatch_statement(s.hub_domain,s.registry_commitment,ready,opening,action.delivery_risk_commitment,dispatch_signed_at);original::assert_signature(provider_key_x,provider_key_y,dispatch_signature,dispatch);let evidence=original::attestation_statement(s.hub_domain,s.registry_commitment,rule_cm,ready,dispatch,cm,gid,observation);quorum::assert_quorum(registry,s.registry_commitment,evidence,attester_indexes,attester_signatures);
}
