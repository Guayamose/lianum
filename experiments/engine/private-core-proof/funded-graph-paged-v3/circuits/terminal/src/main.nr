use paged::{graph,progress};
fn main(public_inputs:pub [Field;46],statement:graph::Statement,final_progress:progress::Progress,final_blinding:[u8;32]){let p=public_inputs;let s=statement;let v=final_progress;graph::assert_statement(s);let domain=graph::domain(s);assert(domain==progress::digest(p,0));assert(s.authorization_root==progress::digest(p,8));assert(s.reserve_nullifier==progress::digest(p,16));assert(progress::commitment(domain,s.authorization_root,s.reserve_nullifier,v,final_blinding)==progress::digest(p,24));assert(s.pages==progress::scalar(p,32));assert(s.nodes==progress::scalar(p,33));assert(s.budget==progress::scalar(p,34));assert(v.revocation_sequence==progress::scalar(p,43));assert(v.next_page==s.pages);assert(v.next_node==s.nodes);assert(v.payout_sum==s.budget);assert(v.page_chain==s.pages_root);assert(v.node_chain==s.nodes_root);assert(v.output_chain==s.outputs_root);assert(v.next_edge==0);assert(v.active_node_digest==[0;32]);assert(v.active_dependency_count==0);assert(v.active_dependency_root==[0;32]);assert(v.max_receipt_from<v.min_receipt_until);assert(progress::scalar(p,44)>=v.max_receipt_from);assert(progress::scalar(p,45)<=v.min_receipt_until);assert(progress::scalar(p,44)<progress::scalar(p,45));assert(progress::scalar(p,45)<=s.settle_before);}
