use paged::{framing,graph,progress};
use native_support::receipt;
fn main(public_inputs:pub [Field;66],statement:graph::Statement,previous:progress::Progress,next:progress::Progress,previous_blinding:[u8;32],next_blinding:[u8;32],next_ready_blinding:[u8;32],mode:u8,
 node:graph::Node,node_siblings:[[u8;32];64],predecessor:graph::Node,predecessor_siblings:[[u8;32];64],predecessor_receipt:[u8;32],predecessor_frontier:[[u8;32];64],
 page:graph::Page,page_siblings:[[u8;32];64],payout:graph::Note,payout_randomness:[u8;32],invoice_signature:[u8;64],output_siblings:[[u8;32];64],
 opening:receipt::ReceiptRead,receipt_spend_secret:[u8;32],frontier_siblings:[[u8;32];64],native_receipt_siblings:[[u8;32];64]){
 let p=public_inputs;let s=statement;graph::assert_statement(s);let domain=graph::domain(s);assert(domain==progress::digest(p,0));assert(s.authorization_root==progress::digest(p,8));assert(s.reserve_nullifier==progress::digest(p,16));
 assert(progress::commitment(domain,s.authorization_root,s.reserve_nullifier,previous,previous_blinding)==progress::digest(p,24));let next_commitment=progress::commitment(domain,s.authorization_root,s.reserve_nullifier,next,next_blinding);assert(next_commitment==progress::digest(p,32));assert(progress::ready(domain,s.authorization_root,s.reserve_nullifier,next_commitment,next_ready_blinding)==progress::digest(p,56));assert(next.revocation_sequence==previous.revocation_sequence);
 let from=progress::scalar(p,64);let until=progress::scalar(p,65);assert(from<until);assert(from>=previous.max_receipt_from);assert(until<=previous.min_receipt_until);assert(until<=s.settle_before);
 progress::assert_node(s,node,node_siblings,previous);let cm=graph::node_digest(node);assert(mode<=1);
 if mode==0{
  // One authenticated edge per work item removes the degree64 restriction.
  progress::same_economic_prefix(previous,next);assert((previous.active_node_digest==[0;32]) | (previous.active_node_digest==cm));if previous.active_node_digest!=[0;32]{assert(previous.active_dependency_count==node.dependency_count);assert(previous.active_dependency_root==node.dependencies);}
  assert(next.active_node_digest==cm);assert(next.active_dependency_root==node.dependencies);assert(next.active_dependency_count==node.dependency_count);assert(previous.next_edge<=node.dependency_count);if previous.next_edge==0{assert(previous.edge_chain==framing::empty_dependencies(s.context,node.ordinal));}
  if node.dependency_count==0{assert(previous.next_edge==0);assert(next.next_edge==0);assert(next.last_dependency==0);assert(next.edge_chain==previous.edge_chain);assert(next.edge_chain==node.dependencies);}else{
   assert(previous.next_edge<node.dependency_count);assert(predecessor.ordinal<node.ordinal);if previous.next_edge>0{assert(previous.last_dependency<predecessor.ordinal);}let predecessor_cm=graph::node_digest(predecessor);graph::member(1,predecessor_cm,predecessor.ordinal,predecessor_siblings,s.nodes_commitment);assert(predecessor_receipt!=[0;32]);let leaf=framing::completed(s.authorization_root,predecessor.ordinal,predecessor_cm,predecessor_receipt);graph::member(3,leaf,predecessor.ordinal,predecessor_frontier,previous.receipt_frontier);assert(next.last_dependency==predecessor.ordinal);assert(next.next_edge==previous.next_edge+1);assert(next.edge_chain==framing::dependency(previous.edge_chain,previous.next_edge,framing::dependency_item(predecessor.ordinal,predecessor_cm)));if next.next_edge==node.dependency_count{assert(next.edge_chain==node.dependencies);}
  }
 }else{
  // CURRENT native facts are checked by the pinned consumer. This proves
  // their exact original receipt tuple, payout opening and secret-derived tag.
  assert(previous.active_node_digest==cm);assert(previous.active_dependency_root==node.dependencies);assert(previous.active_dependency_count==node.dependency_count);assert(previous.next_edge==node.dependency_count);assert(previous.edge_chain==node.dependencies);
  graph::receipt_matches(s,node,opening);let receipt_cm=receipt::receipt_commitment(opening);let tag=receipt::receipt_nullifier(opening,receipt_spend_secret);assert(tag!=[0;32]);assert(opening.valid_from<opening.valid_until);assert(opening.valid_from<=from);assert(until<=opening.valid_until);
  let native_leaf=framing::admitted_receipt(s.authorization_root,receipt_cm,opening.global_effect_id,opening.valid_from,opening.valid_until);graph::member(4,native_leaf,graph::receipt_index(receipt_cm),native_receipt_siblings,progress::digest(p,48));

  assert(payout.value>0);assert(payout.rho==framing::payout_origin(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.operation_id,node.ordinal,payout_randomness));assert(graph::note_commitment(s,payout)==node.payout_commitment);assert(node.payout_commitment!=s.input_commitment);assert(node.payout_commitment!=s.reserve_commitment);assert(node.payout_commitment!=s.change_commitment);assert(node.payout_commitment!=s.recovery_commitment);graph::member(2,node.payout_commitment,node.ordinal,output_siblings,s.outputs_commitment);original64::native_statement::assert_signature(payout.key_x,payout.key_y,invoice_signature,framing::invoice(s.scope,s.policy,s.asset,s.hub_domain,s.registry_commitment,s.authorization_root,node.ordinal,cm,node.payout_commitment,s.settle_before));
  assert((next.payout_sum as u128)==(previous.payout_sum as u128)+(payout.value as u128));assert(next.payout_sum<=s.budget);assert(next.next_node==previous.next_node+1);assert(next.node_chain==framing::nodes(previous.node_chain,node.ordinal,cm));assert(next.output_chain==framing::outputs(previous.output_chain,node.ordinal,node.payout_commitment));assert(next.spent_root==framing::spent(previous.spent_root,node.ordinal,tag));assert(next.effect_root==framing::effects(previous.effect_root,node.ordinal,opening.global_effect_id));
  assert(graph::sparse_root(3,graph::empty_leaf(3),node.ordinal,frontier_siblings)==previous.receipt_frontier);let completed=framing::completed(s.authorization_root,node.ordinal,cm,receipt_cm);assert(graph::sparse_root(3,completed,node.ordinal,frontier_siblings)==next.receipt_frontier);
  assert(next.min_receipt_until==if opening.valid_until<previous.min_receipt_until{opening.valid_until}else{previous.min_receipt_until});assert(next.max_receipt_from==if opening.valid_from>previous.max_receipt_from{opening.valid_from}else{previous.max_receipt_from});assert(next.next_edge==0);assert(next.last_dependency==0);assert(next.active_dependency_count==0);assert(next.active_node_digest==[0;32]);assert(next.active_dependency_root==[0;32]);assert(next.edge_chain==framing::empty_dependencies(s.context,next.next_node));
  assert(page.index==previous.next_page);assert(page.first<=node.ordinal);assert((node.ordinal as u128)<(page.first as u128)+(page.count as u128));let page_cm=graph::page_digest(s,page);graph::member(0,page_cm,page.index,page_siblings,s.pages_commitment);if node.ordinal==page.first{assert(page.previous_nodes==previous.node_chain);assert(page.previous_outputs==previous.output_chain);}if (node.ordinal as u128)+1==(page.first as u128)+(page.count as u128){assert(page.next_nodes==next.node_chain);assert(page.next_outputs==next.output_chain);assert(next.next_page==previous.next_page+1);assert(next.page_chain==framing::pages(previous.page_chain,page.index,page_cm));}else{assert(next.next_page==previous.next_page);assert(next.page_chain==previous.page_chain);}
 }
}
