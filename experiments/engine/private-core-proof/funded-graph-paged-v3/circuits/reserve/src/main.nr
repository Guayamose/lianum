use paged::{graph,progress};
fn main(public_inputs:pub [Field;119],witness:graph::Reserve,source_siblings:[[u8;32];8],source_index:u32,initial_blinding:[u8;32],initial_ready_blinding:[u8;32]){let p=public_inputs;let s=witness.statement;graph::assert_reserve(witness);assert(graph::domain(s)==progress::digest(p,0));assert(s.authorization_root==progress::digest(p,8));assert(s.input_nullifier==progress::digest(p,16));assert(s.reserve_nullifier==progress::digest(p,24));assert(s.pages_root==progress::digest(p,32));assert(s.nodes_root==progress::digest(p,40));assert(s.outputs_root==progress::digest(p,48));assert(s.context==progress::digest(p,56));assert(s.recovery_commitment==progress::digest(p,64));assert(s.change_commitment==progress::digest(p,72));assert(s.pages==progress::scalar(p,96));assert(s.nodes==progress::scalar(p,97));assert(s.budget==progress::scalar(p,98));assert(s.funding_not_before==progress::scalar(p,99));assert(s.funding_valid_until==progress::scalar(p,100));assert(s.settle_before==progress::scalar(p,101));assert(s.outputs_commitment==progress::digest(p,80));graph::source_membership(s.input_commitment,source_siblings,source_index,progress::digest(p,88));let v=progress::initial(s,progress::scalar(p,118));let c=progress::commitment(graph::domain(s),s.authorization_root,s.reserve_nullifier,v,initial_blinding);assert(c==progress::digest(p,102));assert(progress::ready(graph::domain(s),s.authorization_root,s.reserve_nullifier,c,initial_ready_blinding)==progress::digest(p,110));}
