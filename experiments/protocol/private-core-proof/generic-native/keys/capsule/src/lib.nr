pub global VK_HASH: Field = 9597965926126013708428926108147193223739411680637150424440950762072771276128;

pub fn verify(proof: [Field; 458], inputs: [Field; 129]) {
    bb_honk_verifier::verify_honk_proof(VK, proof, inputs, VK_HASH);
    for i in 0..128 {
        let value = inputs[i] as u32;
        assert(value as Field == inputs[i]);
    }
    for i in 128..129 {
        let value = inputs[i] as u64;
        assert(value as Field == inputs[i]);
    }
}
