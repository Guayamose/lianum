  "type": "module",
  "scripts": {
    "start:native": "node --max-old-space-size=384 src/entry.mjs paged-native-new",
    "start:mixed": "node --max-old-space-size=384 src/entry.mjs paged-mixed-new",
    "reopen:native": "node --max-old-space-size=384 src/entry.mjs paged-native-reopen",
