# Copy to .env in this directory; keep .env private and outside Git.
LIANUM_AGENT_DIRECTORY=/absolute/path/to/private/lianum-agent
LIANUM_AGENT_GATEWAY_TOKEN=replace-with-the-same-random-secret-in-the-api-service
OPENAI_API_KEY=
LIANUM_AGENT_MODEL=gpt-6-luna
# session: request a per-session cap; unsupported API configurations stop.
# account: explicitly rely on externally configured OpenAI account/project limits.
LIANUM_AGENT_BUDGET_MODE=session
# Used only in session mode; USD cents, not EUR or a project-wide budget.
LIANUM_AGENT_SESSION_BUDGET_CENTS=25
LIANUM_AGENT_WEB_SEARCH=false
LIANUM_AGENT_ALLOW_OTHER_MODELS=false
# Optional keyless wallet reader, on the same machine as the API service.
# Set both values; the API needs the same separate backend token.
LIANUM_AGENT_BACKEND_URL=
LIANUM_AGENT_BACKEND_TOKEN=
# Fixed public API origin for observing finite device-signed operation grants.
LIANUM_AGENT_OPERATION_ORIGIN=
# Android notifications: attach this dedicated FCM service account to the VM.
# No downloaded private key is needed. Leave both empty to disable push.
LIANUM_AGENT_FCM_PROJECT=
LIANUM_AGENT_FCM_SERVICE_ACCOUNT=
# Native GPT-Live voice, independently budgeted from backend inference.
LIANUM_AGENT_VOICE=false
# Cumulative USD micro-units reserved in SQLite; $5 for this deployment.
# This does not enforce the separate EUR 50 total project budget.
LIANUM_AGENT_VOICE_BUDGET_MICROS=5000000
PORT=8790
