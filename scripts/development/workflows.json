  "entrypoints": [
    {"id": "wallet", "level": "host", "entry": "apps/wallet/src/server/run.mjs", "command": "./dev start", "description": "Wallet web local; la disponibilidad económica depende del perfil conectado."},
    {"id": "mobile", "level": "component", "entry": "apps/mobile/package.json", "command": "./dev npm --prefix apps/mobile start", "description": "Cliente Expo; necesita dependencias móviles y un development build."},
    {"id": "platform", "level": "component", "entry": "apps/platform/src/run.mjs", "command": "./dev npm --prefix apps/platform start", "description": "API local; configurar PostgreSQL y custodia según apps/platform/README.md."},
    {"id": "paired-http", "level": "integration", "entry": "tests/integration/mobile/paired-original-account-http-v2.test.mjs", "command": "./dev test tests/integration/mobile/paired-original-account-http-v2.test.mjs", "description": "Contrato HTTP pareado con fixtures; no aceptación económica."},
    {"id": "postgres", "level": "integration", "entry": "apps/platform/scripts/test-postgres.mjs", "command": "./dev npm --prefix apps/platform run test:postgres", "description": "Persistencia PostgreSQL real en Docker, con base de datos de prueba."},
    {"id": "evm", "level": "economic", "entry": "scripts/development/evm_lab.py", "command": "./dev lab run", "description": "Laboratorio EVM con identidades nuevas, redes y pruebas originales; requiere materiales públicos."},
    {"id": "evm-recovery", "level": "economic", "entry": "scripts/development/evm_lab.py", "command": "./dev lab recovery", "description": "Recuperación EVM en laboratorio nuevo; ejecución explícita."},
    {"id": "original-account", "level": "economic", "entry": "scripts/development/paired_original_account_lab.py", "command": "./dev lab mobile-original", "description": "Cuenta original V2 pareada: lectura y reconciliación; no equivale a cliente móvil completo."},
    {"id": "defi", "level": "economic", "entry": "scripts/development/defi_entry_lab.py", "command": "./dev lab defi", "description": "Laboratorio Uniswap/MetaMorpho y salida según docs/DEVELOPMENT.md."}
  ]
}
