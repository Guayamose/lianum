{
  "schema": "LIANUM_DEVELOPMENT_WORKFLOWS_V1",
  "components": {
    "wallet": {
      "watch": [
        "apps/wallet/"
      ],
      "tests": [
        "apps/wallet/tests/server/public-errors.test.mjs",
        "apps/wallet/tests/server/exact-action-capabilities.test.mjs",
        "apps/wallet/tests/client/ui.test.mjs"
      ]
    },
    "backend": {
      "watch": [
        "packages/backend/"
      ],
      "tests": [
        "packages/backend/tests/api/wallet/wallet-application-client.test.mjs",
        "packages/backend/tests/api/wallet/wallet-application-client.transport.test.mjs",
        "packages/backend/tests/execution/account/execution/native-value-terminal-first.test.mjs",
        "packages/backend/tests/accounts/storage/durable-generic-account-keeper.test.mjs",
        "packages/backend/tests/accounts/authority/native-value-withdrawal-context.test.mjs",
        "packages/backend/tests/accounts/authority/native-value-authority-journals.test.mjs",
        "packages/backend/tests/chains/shared/portfolio/observation-error-contract.test.mjs",
        "packages/backend/tests/chains/shared/portfolio/portfolio-registry.test.mjs",
        "packages/backend/tests/chains/shared/portfolio/http-portfolio-registry.test.mjs",
        "packages/backend/tests/claims/operations/operator-boundary.test.mjs"
      ]
    },
    "custody": {
      "watch": [
        "packages/custody/"
      ],
      "tests": [
        "packages/custody/tests/signing/authorized-envelope.test.mjs",
        "packages/custody/tests/preparation/flat-owner-preparation-terms.test.mjs"
      ]
    },
    "engine": {
      "watch": [
        "packages/engine/"
      ],
      "tests": [
        "packages/engine/tests/core/core.test.mjs",
        "packages/engine/tests/core/settlement.test.mjs"
      ]
    },
    "protocol": {
      "watch": [
        "packages/protocol/"
      ],
      "tests": [
        "packages/protocol/tests/native/native-hub-messages.test.mjs",
        "packages/protocol/tests/execution/proofs/proof-resource-policy.test.mjs"
      ]
    },
    "proofs": {
      "watch": [
        "packages/proofs/"
      ],
      "tests": [
        "packages/proofs/tests/jobs/standard-proof-resources-v1.test.mjs",
        "packages/proofs/tests/jobs/native-flow-proof-scope-v1.test.mjs",
        "packages/proofs/tests/jobs/native-device-private-deposit-diagnostic-v2.test.mjs"
      ]
    },
    "crypto": {
      "watch": [
        "packages/crypto/"
      ],
      "tests": [
        "packages/crypto/test/encoding.test.mjs"
      ]
    },
    "components": {
      "watch": [
        "packages/components/"
      ],
      "tests": [
        "packages/components/test/framing.test.mjs",
        "packages/components/test/encoding-boundary.test.mjs"
      ]
    },
    "environment": {
      "watch": [
        "packages/environment/"
      ],
      "tests": [
        "scripts/development/test_source_runtime.py",
        "scripts/development/test_source_bundle.py"
      ]
    },
    "contracts": {
      "watch": [
        "contracts/"
      ],
      "tests": [],
      "manual": "Seleccionar compilación y pruebas del contrato cambiado; el catálogo host no acredita bytecode ni despliegue. Consultar contracts/README.md."
    },
    "mobile": {
      "watch": [
        "apps/mobile/",
        "packages/mobile-protocol/"
      ],
      "tests": [
        "apps/mobile/tests/authorization.test.mjs",
        "apps/mobile/tests/original-account-api-v2.test.mjs",
        "apps/mobile/tests/local-root-note-vault-v1.test.mjs",
        "packages/mobile-protocol/tests/shared-entrypoints.test.mjs",
        "packages/mobile-protocol/tests/wallet-client-architecture.test.mjs"
      ]
    },
    "platform": {
      "watch": [
        "apps/platform/"
      ],
      "tests": [
        "apps/platform/tests/server.test.mjs",
        "apps/platform/tests/privacy-key-v1.test.mjs",
        "apps/platform/tests/schema-migrations.test.mjs",
        "apps/platform/tests/gateway-pairing.test.mjs",
        "apps/platform/tests/diagnostics.test.mjs",
        "apps/platform/tests/composition.test.mjs"
      ]
    },
    "tooling": {
      "watch": [
        "dev",
        "scripts/development/",
        "scripts/layout.json",
        "scripts/module-boundaries.json",
        "package.json",
        "package-lock.json",
        ".github/workflows/"
      ],
      "tests": [
        "scripts/development/test_workflow.py",
        "scripts/development/test_source_runtime.py",
        "scripts/development/test_source_preparation.py",
        "scripts/development/test_module_boundaries.py",
        "scripts/development/test_source_generations.py",
        "scripts/development/test_workspace.py",
        "scripts/development/test_doctor.py",
        "scripts/development/test_bounded_process.py",
        "scripts/development/test-static-check.test.mjs",
        "scripts/development/test_clean.py",
        "scripts/development/test_local_resources.py",
        "scripts/development/test_source_pins.py",
        "scripts/development/test_lab_profiles.py",
        "scripts/development/test_source_bundle.py"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "wallet",
      "level": "host",
      "entry": "apps/wallet/src/server/run.mjs",
      "command": "./dev start",
      "description": "Wallet web local; la disponibilidad económica depende del perfil conectado."
    },
    {
      "id": "mobile",
      "level": "component",
      "entry": "apps/mobile/package.json",
      "command": "./dev npm --prefix apps/mobile start",
      "description": "Cliente Expo; necesita dependencias móviles y un development build."
    },
    {
      "id": "platform",
      "level": "component",
      "entry": "apps/platform/src/entry.mjs",
      "command": "./dev platform admission",
      "description": "API de admisión; original-native-new y original-native-reopen son perfiles explícitos con configuración privada y estado original conservado."
    },
    {
      "id": "paired-http",
      "level": "integration",
      "entry": "tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "command": "./dev test tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "description": "Contrato HTTP pareado con fixtures; no aceptación económica."
    },
    {
      "id": "postgres",
      "level": "integration",
      "entry": "apps/platform/scripts/test-postgres.mjs",
      "command": "./dev npm --prefix apps/platform run test:postgres",
      "description": "Persistencia PostgreSQL real en Docker, con base de datos de prueba."
    },
    {
      "id": "evm",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab run",
      "description": "Laboratorio EVM con identidades nuevas, redes y pruebas originales; requiere materiales públicos."
    },
    {
      "id": "evm-recovery",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab recovery",
      "description": "Recuperación EVM en laboratorio nuevo; ejecución explícita."
    },
    {
      "id": "original-account",
      "level": "economic",
      "entry": "scripts/development/paired_original_account_lab.py",
      "command": "./dev lab mobile-original",
      "description": "Cuenta original V2 pareada: lectura y reconciliación; no equivale a cliente móvil completo."
    },
    {
      "id": "defi",
      "level": "economic",
      "entry": "scripts/development/defi_entry_lab.py",
      "command": "./dev lab defi",
      "description": "Laboratorio Uniswap/MetaMorpho y salida según docs/DEVELOPMENT.md."
    }
  ],
  "commands": [
    {
      "usage": "./dev start",
      "description": "Arrancar la wallet desde fuentes editables; Ctrl+C para cerrar"
    },
    {
      "usage": "./dev platform [admission|original-native-new|original-native-reopen]",
      "description": "Arrancar API o perfil original explícito, con estado conservado"
    },
    {
      "usage": "./dev build",
      "description": "Preparar paquetes y lock; no genera la compatibilidad"
    },
    {
      "usage": "./dev check",
      "description": "Comprobar módulos, análisis estático y selección host"
    },
    {
      "usage": "./dev test [rutas] [--timeout 120]",
      "description": "Pruebas host con salida en directo y plazo por selección"
    },
    {
      "usage": "./dev test --changed [--plan]",
      "description": "Seleccionar pruebas del cambio; límite de 24 archivos y 120 s"
    },
    {
      "usage": "./dev test --component NOMBRE",
      "description": "Comprobaciones acotadas de uno o varios componentes"
    },
    {
      "usage": "./dev static [--changed]",
      "description": "Sintaxis e imports del núcleo; checkJs estricto de APIs declaradas"
    },
    {
      "usage": "./dev status",
      "description": "Presencia y versión de herramientas; no certifica integridad"
    },
    {
      "usage": "./dev prepare [host|mobile|platform]",
      "description": "Instalar dependencias públicas del perfil"
    },
    {
      "usage": "./dev workflows",
      "description": "Entradas vigentes y alcance de cada comprobación"
    },
    {
      "usage": "./dev boundaries",
      "description": "Comprobar dependencias y exports entre módulos"
    },
    {
      "usage": "./dev sources [status|prepare|check]",
      "description": "Inspeccionar o preparar una generación de desarrollo"
    },
    {
      "usage": "./dev bundle [build|verify|run]",
      "description": "Empaquetar fuentes y recursos declarados en un candidato trasladable"
    },
    {
      "usage": "./dev pins [check|update] [--profile NOMBRE]",
      "description": "Revisar o actualizar hashes actuales; conserva publicaciones históricas"
    },
    {
      "usage": "./dev resources [status|check]",
      "description": "Espacio por función y rutas locales sin clasificar"
    },
    {
      "usage": "./dev resources migrate-caches [--apply]",
      "description": "Previsualizar o mover cachés a su ubicación común"
    },
    {
      "usage": "./dev lab profiles",
      "description": "Mostrar perfiles y alcance del inventario mínimo"
    },
    {
      "usage": "./dev lab [plan|check] PERFIL",
      "description": "Inspeccionar dependencias del perfil sin ejecutar redes"
    },
    {
      "usage": "./dev lab prepare-profile PERFIL",
      "description": "Preparar solo dependencias y compatibilidad necesarias del perfil"
    },
    {
      "usage": "./dev clean [--scope caches|history|all] [--apply]",
      "description": "Previsualizar limpieza por clase; --apply aplica la selección"
    },
    {
      "usage": "./dev build --legacy",
      "description": "Materializar expresamente la compatibilidad histórica"
    },
    {
      "usage": "./dev legacy [start|node|test|check]",
      "description": "Ejecutar el recorrido heredado correspondiente"
    },
    {
      "usage": "./dev doctor",
      "description": "Comprobar restauración e integridad; necesita materiales"
    },
    {
      "usage": "./dev artifacts",
      "description": "Inventariar originales históricos ausentes"
    },
    {
      "usage": "./dev evidence",
      "description": "Verificar evidencias públicas originales restauradas"
    },
    {
      "usage": "./dev node [args]",
      "description": "Node local sobre las fuentes editables"
    },
    {
      "usage": "./dev npm [args]",
      "description": "npm con el Node local"
    },
    {
      "usage": "./dev lab [prepare|run|recovery]",
      "description": "Laboratorio EVM explícito; no se añade a pruebas host"
    },
    {
      "usage": "./dev lab [browser|browser-recovery]",
      "description": "Recorrido económico EVM desde el navegador"
    },
    {
      "usage": "./dev lab [btc-sol|claims|osaka]",
      "description": "Laboratorios nativos explícitos; requieren materiales"
    },
    {
      "usage": "./dev lab [defi|metamorpho]",
      "description": "Laboratorios DeFi explícitos con custodia y pruebas"
    },
    {
      "usage": "./dev lab mobile-original",
      "description": "Cuenta original V2 pareada: lectura y conciliación"
    },
    {
      "usage": "./dev lab mobile-original-ledger",
      "description": "Compilar ledger nativo V5 con watchdog propio"
    },
    {
      "usage": "./dev lab audit-base",
      "description": "Auditorías originales vacías; ejecución explícita"
    },
    {
      "usage": "./dev [setup|import|restore-package]",
      "description": "Restauración de herramientas y materiales originales"
    },
    {
      "usage": "./dev canonical",
      "description": "Preparar la ubicación fija del lector I84"
    },
    {
      "usage": "./dev [legacy-node|proof-node] [args]",
      "description": "Runtimes fijados de compatibilidad"
    }
  ]
}
