{
  "schema": "LIANUM_DEVELOPMENT_WORKFLOWS_V1",
  "components": {
    "wallet": {
      "watch": [
        "apps/wallet/"
      ],
      "tests": [
        "apps/wallet/tests/server/public-errors.test.mjs",
        "apps/wallet/tests/server/exact-action-capabilities.test.mjs",
        "apps/wallet/tests/client/ui.test.mjs"
      ]
    },
    "backend": {
      "watch": [
        "packages/backend/"
      ],
      "tests": [
        "packages/backend/tests/api/wallet/wallet-application-client.test.mjs",
        "packages/backend/tests/api/wallet/wallet-application-client.transport.test.mjs",
        "packages/backend/tests/execution/account/execution/native-value-terminal-first.test.mjs",
        "packages/backend/tests/accounts/storage/durable-generic-account-keeper.test.mjs",
        "packages/backend/tests/accounts/authority/native-value-withdrawal-context.test.mjs",
        "packages/backend/tests/accounts/authority/native-value-authority-journals.test.mjs"
      ]
    },
    "custody": {
      "watch": [
        "packages/custody/"
      ],
      "tests": [
        "packages/custody/tests/signing/authorized-envelope.test.mjs",
        "packages/custody/tests/preparation/flat-owner-preparation-terms.test.mjs"
      ]
    },
    "engine": {
      "watch": [
        "packages/engine/"
      ],
      "tests": [
        "packages/engine/tests/core/core.test.mjs",
        "packages/engine/tests/core/settlement.test.mjs"
      ]
    },
    "protocol": {
      "watch": [
        "packages/protocol/"
      ],
      "tests": [
        "packages/protocol/tests/native/native-hub-messages.test.mjs",
        "packages/protocol/tests/execution/proofs/proof-resource-policy.test.mjs"
      ]
    },
    "proofs": {
      "watch": [
        "packages/proofs/"
      ],
      "tests": [
        "packages/proofs/tests/jobs/standard-proof-resources-v1.test.mjs",
        "packages/proofs/tests/jobs/native-flow-proof-scope-v1.test.mjs",
        "packages/proofs/tests/jobs/native-device-private-deposit-diagnostic-v2.test.mjs"
      ]
    },
    "crypto": {
      "watch": [
        "packages/crypto/"
      ],
      "tests": [
        "packages/crypto/test/encoding.test.mjs"
      ]
    },
    "components": {
      "watch": [
        "packages/components/"
      ],
      "tests": [
        "packages/components/test/framing.test.mjs",
        "packages/components/test/encoding-boundary.test.mjs"
      ]
    },
    "environment": {
      "watch": [
        "packages/environment/"
      ],
      "tests": [
        "scripts/development/test_source_runtime.py"
      ]
    },
    "contracts": {
      "watch": [
        "contracts/"
      ],
      "tests": [],
      "manual": "Seleccionar compilaci\u00f3n y pruebas del contrato cambiado; el cat\u00e1logo host no acredita bytecode ni despliegue. Consultar contracts/README.md."
    },
    "mobile": {
      "watch": [
        "apps/mobile/",
        "packages/mobile-protocol/"
      ],
      "tests": [
        "apps/mobile/tests/authorization.test.mjs",
        "apps/mobile/tests/original-account-api-v2.test.mjs",
        "apps/mobile/tests/local-root-note-vault-v1.test.mjs",
        "packages/mobile-protocol/tests/shared-entrypoints.test.mjs",
        "packages/mobile-protocol/tests/wallet-client-architecture.test.mjs"
      ]
    },
    "platform": {
      "watch": [
        "apps/platform/"
      ],
      "tests": [
        "apps/platform/tests/server.test.mjs",
        "apps/platform/tests/privacy-key-v1.test.mjs",
        "apps/platform/tests/schema-migrations.test.mjs",
        "apps/platform/tests/gateway-pairing.test.mjs",
        "apps/platform/tests/diagnostics.test.mjs",
        "apps/platform/tests/composition.test.mjs"
      ]
    },
    "tooling": {
      "watch": [
        "dev",
        "scripts/development/",
        "scripts/layout.json",
        "scripts/module-boundaries.json",
        "package.json",
        "package-lock.json",
        ".github/workflows/"
      ],
      "tests": [
        "scripts/development/test_workflow.py",
        "scripts/development/test_source_runtime.py",
        "scripts/development/test_source_preparation.py",
        "scripts/development/test_module_boundaries.py",
        "scripts/development/test_source_generations.py",
        "scripts/development/test_workspace.py",
        "scripts/development/test_doctor.py",
        "scripts/development/test_bounded_process.py",
        "scripts/development/test-static-check.test.mjs"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "wallet",
      "level": "host",
      "entry": "apps/wallet/src/server/run.mjs",
      "command": "./dev start",
      "description": "Wallet web local; la disponibilidad econ\u00f3mica depende del perfil conectado."
    },
    {
      "id": "mobile",
      "level": "component",
      "entry": "apps/mobile/package.json",
      "command": "./dev npm --prefix apps/mobile start",
      "description": "Cliente Expo; necesita dependencias m\u00f3viles y un development build."
    },
    {
      "id": "platform",
      "level": "component",
      "entry": "apps/platform/src/entry.mjs",
      "command": "./dev platform admission",
      "description": "API de admisi\u00f3n; original-native-new y original-native-reopen son perfiles expl\u00edcitos con configuraci\u00f3n privada y estado original conservado."
    },
    {
      "id": "paired-http",
      "level": "integration",
      "entry": "tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "command": "./dev test tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "description": "Contrato HTTP pareado con fixtures; no aceptaci\u00f3n econ\u00f3mica."
    },
    {
      "id": "postgres",
      "level": "integration",
      "entry": "apps/platform/scripts/test-postgres.mjs",
      "command": "./dev npm --prefix apps/platform run test:postgres",
      "description": "Persistencia PostgreSQL real en Docker, con base de datos de prueba."
    },
    {
      "id": "evm",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab run",
      "description": "Laboratorio EVM con identidades nuevas, redes y pruebas originales; requiere materiales p\u00fablicos."
    },
    {
      "id": "evm-recovery",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab recovery",
      "description": "Recuperaci\u00f3n EVM en laboratorio nuevo; ejecuci\u00f3n expl\u00edcita."
    },
    {
      "id": "original-account",
      "level": "economic",
      "entry": "scripts/development/paired_original_account_lab.py",
      "command": "./dev lab mobile-original",
      "description": "Cuenta original V2 pareada: lectura y reconciliaci\u00f3n; no equivale a cliente m\u00f3vil completo."
    },
    {
      "id": "defi",
      "level": "economic",
      "entry": "scripts/development/defi_entry_lab.py",
      "command": "./dev lab defi",
      "description": "Laboratorio Uniswap/MetaMorpho y salida seg\u00fan docs/DEVELOPMENT.md."
    }
  ],
  "commands": [
    {
      "usage": "./dev start",
      "description": "Arrancar la wallet desde fuentes editables; Ctrl+C para cerrar"
    },
    {
      "usage": "./dev platform [admission|original-native-new|original-native-reopen]",
      "description": "Arrancar API o perfil original expl\u00edcito, con estado conservado"
    },
    {
      "usage": "./dev build",
      "description": "Preparar paquetes y lock; no genera la compatibilidad"
    },
    {
      "usage": "./dev check",
      "description": "Comprobar m\u00f3dulos, an\u00e1lisis est\u00e1tico y selecci\u00f3n host"
    },
    {
      "usage": "./dev test [rutas] [--timeout 120]",
      "description": "Pruebas host con salida en directo y plazo por selecci\u00f3n"
    },
    {
      "usage": "./dev test --changed [--plan]",
      "description": "Seleccionar pruebas del cambio; l\u00edmite de 24 archivos y 120 s"
    },
    {
      "usage": "./dev test --component NOMBRE",
      "description": "Comprobaciones acotadas de uno o varios componentes"
    },
    {
      "usage": "./dev static [--changed]",
      "description": "Sintaxis e imports del n\u00facleo; checkJs estricto de APIs declaradas"
    },
    {
      "usage": "./dev status",
      "description": "Presencia y versi\u00f3n de herramientas; no certifica integridad"
    },
    {
      "usage": "./dev prepare [host|mobile|platform]",
      "description": "Instalar dependencias p\u00fablicas del perfil"
    },
    {
      "usage": "./dev workflows",
      "description": "Entradas vigentes y alcance de cada comprobaci\u00f3n"
    },
    {
      "usage": "./dev boundaries",
      "description": "Comprobar dependencias y exports entre m\u00f3dulos"
    },
    {
      "usage": "./dev sources [status|prepare|check]",
      "description": "Inspeccionar o preparar una generaci\u00f3n de desarrollo"
    },
    {
      "usage": "./dev clean [--apply]",
      "description": "Proponer limpieza; --apply respalda y retira cach\u00e9s elegibles"
    },
    {
      "usage": "./dev build --legacy",
      "description": "Materializar expresamente la compatibilidad hist\u00f3rica"
    },
    {
      "usage": "./dev legacy [start|node|test|check]",
      "description": "Ejecutar el recorrido heredado correspondiente"
    },
    {
      "usage": "./dev doctor",
      "description": "Comprobar restauraci\u00f3n e integridad; necesita materiales"
    },
    {
      "usage": "./dev artifacts",
      "description": "Inventariar originales hist\u00f3ricos ausentes"
    },
    {
      "usage": "./dev evidence",
      "description": "Verificar evidencias p\u00fablicas originales restauradas"
    },
    {
      "usage": "./dev node [args]",
      "description": "Node local sobre las fuentes editables"
    },
    {
      "usage": "./dev npm [args]",
      "description": "npm con el Node local"
    },
    {
      "usage": "./dev lab [prepare|run|recovery]",
      "description": "Laboratorio EVM expl\u00edcito; no se a\u00f1ade a pruebas host"
    },
    {
      "usage": "./dev lab [browser|browser-recovery]",
      "description": "Recorrido econ\u00f3mico EVM desde el navegador"
    },
    {
      "usage": "./dev lab [btc-sol|claims|osaka]",
      "description": "Laboratorios nativos expl\u00edcitos; requieren materiales"
    },
    {
      "usage": "./dev lab [defi|metamorpho]",
      "description": "Laboratorios DeFi expl\u00edcitos con custodia y pruebas"
    },
    {
      "usage": "./dev lab mobile-original",
      "description": "Cuenta original V2 pareada: lectura y conciliaci\u00f3n"
    },
    {
      "usage": "./dev lab mobile-original-ledger",
      "description": "Compilar ledger nativo V5 con watchdog propio"
    },
    {
      "usage": "./dev lab audit-base",
      "description": "Auditor\u00edas originales vac\u00edas; ejecuci\u00f3n expl\u00edcita"
    },
    {
      "usage": "./dev [setup|import|restore-package]",
      "description": "Restauraci\u00f3n de herramientas y materiales originales"
    },
    {
      "usage": "./dev canonical",
      "description": "Preparar la ubicaci\u00f3n fija del lector I84"
    },
    {
      "usage": "./dev [legacy-node|proof-node] [args]",
      "description": "Runtimes fijados de compatibilidad"
    }
  ]
}
