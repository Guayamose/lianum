  "entrypoints": [
    {
      "id": "api-server",
      "level": "host",
      "entry": "services/api-server/src/wallet-entry.mjs",
      "command": "./dev api",
      "description": "Public wallet API; requires server configuration."
    },
    {
      "id": "mobile",
      "level": "component",
      "entry": "apps/mobile/package.json",
      "command": "./dev npm --prefix apps/mobile start",
      "description": "Expo client; requires mobile dependencies and a development build."
    },
    {
      "id": "api-admission",
      "level": "component",
      "entry": "services/api-server/src/entry.mjs",
      "command": "./dev platform admission",
      "description": "Public API entry point and authorized admission profiles."
    },
    {
      "id": "paired-http",
      "level": "integration",
      "entry": "tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "command": "./dev test tests/integration/mobile/paired-original-account-http-v2.test.mjs",
      "description": "Paired HTTP contract with fixtures; not economic acceptance."
    },
    {
      "id": "postgres",
      "level": "integration",
      "entry": "services/api-server/scripts/test-postgres.mjs",
      "command": "./dev npm --prefix services/api-server run test:postgres",
      "description": "Real PostgreSQL persistence in Docker using a test database."
    },
    {
      "id": "evm",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab run",
      "description": "EVM laboratory with fresh identities, networks and original proofs; requires public resources."
    },
    {
      "id": "evm-recovery",
      "level": "economic",
      "entry": "scripts/development/evm_lab.py",
      "command": "./dev lab recovery",
      "description": "EVM recovery in a fresh laboratory; explicit execution."
    },
    {
      "id": "original-account",
      "level": "economic",
      "entry": "scripts/development/paired_original_account_lab.py",
      "command": "./dev lab mobile-original",
      "description": "Paired original V2 account: read and reconcile; not complete mobile acceptance."
    },
    {
      "id": "defi",
      "level": "economic",
      "entry": "scripts/development/defi_entry_lab.py",
      "command": "./dev lab defi",
      "description": "Uniswap/MetaMorpho laboratory and withdrawal path described in docs/DEVELOPMENT.md."
    },
    {
      "id": "wrapped-lifecycle-campaign",
      "level": "campaign",
      "entry": "packages/backend/tests/operations/payouts/wrapped-authorization-lifecycle-v4.test.mjs",
      "command": "./dev test --timeout 3600 packages/backend/tests/operations/payouts/wrapped-authorization-lifecycle-v4.test.mjs",
      "description": "69 wrapped-authorization cases with reciprocal audits and complete original sources; explicitly slow, not economic acceptance."
    },
    {
      "id": "wrapped-runtime-campaign",
      "level": "campaign",
      "entry": "packages/backend/tests/chains/shared/runtime/wrapped-graph-v4-runtime.test.mjs",
      "command": "./dev test --timeout 3600 packages/backend/tests/chains/shared/runtime/wrapped-graph-v4-runtime.test.mjs",
      "description": "22 EVM/TRON cases for one-use authority, signatures and time limits with complete owners and lower-level test ports; explicitly slow."
    },
    {
      "id": "paeg-engine",
      "level": "component",
      "entry": "services/paeg-engine/src/entry.mjs",
      "command": "./dev engine paged-mixed-reopen",
      "description": "Reopen the engine using retained state. New profiles require explicit private preparation."
    },
    {
      "id": "agent",
      "level": "host",
      "entry": "services/agent/src/entry.mjs",
      "command": "./dev npm --prefix services/agent start",
      "description": "Persistent agent; requires a private directory and internal token. AI uses OPENAI_API_KEY."
    }
  ],
  "commands": [
    {
      "usage": "./dev api",
      "description": "Start the public API using LIANUM_PUBLIC_WALLET_CONFIG."
    },
    {
      "usage": "./dev engine [admission|original-native-new|original-native-reopen|paged-native-new|paged-native-reopen|paged-mixed-new|paged-mixed-reopen|defi-new]",
      "description": "Start an explicit profile; new requires fresh state, reopen retains the original state."
    },
    {
      "usage": "./dev build",
      "description": "Prepare packages and lockfile; does not generate compatibility resources."
    },
    {
      "usage": "./dev check",
      "description": "Check module boundaries, static analysis and the host selection."
    },
    {
      "usage": "./dev block-check [--plan]",
      "description": "Full maintained suite, runtime imports and mobile types; no skipped checks or adoption."
    },
    {
      "usage": "./dev test [paths] [--timeout 120]",
      "description": "Host tests with live output and a deadline per selection."
    },
    {
      "usage": "./dev test --changed [--plan]",
      "description": "Select checks for the change; limit 24 files and 120 seconds."
    },
    {
      "usage": "./dev test --component NAME",
      "description": "Bounded checks for one or more components."
    },
    {
      "usage": "./dev static [--changed]",
      "description": "Core syntax/import checks and strict checkJs for declared APIs."
    },
    {
      "usage": "./dev status",
      "description": "Tool presence and versions; does not certify integrity."
    },
    {
      "usage": "./dev prepare [host|mobile|api-server]",
      "description": "Install the public dependencies for the selected profile."
    },
    {
      "usage": "./dev workflows",
      "description": "Current entry points and the scope of each check."
    },
    {
      "usage": "./dev boundaries",
      "description": "Check dependencies and exports between modules."
    },
    {
      "usage": "./dev sources [status|prepare|check|verify|adopt]",
      "description": "Inspect, prepare, verify or adopt a source generation by digest."
    },
    {
      "usage": "./dev sources prepare --adopt",
      "description": "Prepare and adopt verified current sources without copying hashes manually."
    },
    {
      "usage": "./dev bundle [build|verify|run]",
      "description": "Package declared sources and resources as a portable candidate."
    },
    {
      "usage": "./dev pins [check|update] [--profile NAME]",
      "description": "Review or update current hashes; preserve historical publications."
    },
    {
      "usage": "./dev resources [status|check]",
      "description": "Storage by purpose and unclassified local paths."
    },
    {
      "usage": "./dev resources migrate-caches [--apply]",
      "description": "Preview or move caches to their shared location."
    },
    {
      "usage": "./dev lab profiles",
      "description": "Show profiles and minimum inventory scope."
    },
    {
      "usage": "./dev lab [plan|check] PROFILE",
      "description": "Inspect profile dependencies without starting networks."
    },
    {
      "usage": "./dev lab prepare-profile PROFILE",
      "description": "Prepare only the dependencies and compatibility required by the profile."
    },
    {
      "usage": "./dev clean [--scope caches|history|all] [--apply]",
      "description": "Preview cleanup by category; --apply executes the selection."
    },
    {
      "usage": "./dev build --legacy",
      "description": "Explicitly materialize historical compatibility resources."
    },
    {
      "usage": "./dev legacy [node|test|check]",
      "description": "Run the corresponding legacy path."
    },
    {
      "usage": "./dev doctor",
      "description": "Check installed tools and current source hashes."
    },
    {
      "usage": "./dev artifacts",
      "description": "Inventory missing historical originals."
    },
    {
      "usage": "./dev evidence",
      "description": "Verify restored original public evidence."
    },
    {
      "usage": "./dev node [args]",
      "description": "Local Node against editable sources."
    },
    {
      "usage": "./dev npm [args]",
      "description": "npm using the local pinned Node."
    },
    {
      "usage": "./dev lab [prepare|run|recovery]",
      "description": "Explicit EVM laboratory; never added to host tests automatically."
    },
    {
      "usage": "./dev lab [browser|browser-recovery]",
      "description": "EVM economic flow from the browser."
    },
    {
      "usage": "./dev lab [btc-sol|claims|osaka]",
      "description": "Explicit native laboratories; require their retained resources."
    },
    {
      "usage": "./dev lab [defi|metamorpho]",
      "description": "Explicit DeFi laboratories with custody and proofs."
    },
    {
      "usage": "./dev lab mobile-original",
      "description": "Paired original V2 account: read and reconcile."
    },
    {
      "usage": "./dev lab mobile-original-ledger",
      "description": "Compile native ledger V5 with an owned watchdog."
    },
    {
      "usage": "./dev lab audit-base",
      "description": "Original empty audits; explicit execution."
    },
    {
      "usage": "./dev canonical",
      "description": "Prepare the fixed location required by the I84 reader."
    },
    {
      "usage": "./dev [legacy-node|proof-node] [args]",
      "description": "Pinned compatibility runtimes."
    }
  ]
}
