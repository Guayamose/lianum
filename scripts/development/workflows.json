    },
    "mobile": {
      "watch": ["apps/mobile/", "packages/mobile-protocol/"],
      "tests": ["apps/mobile/tests/authorization.test.mjs", "apps/mobile/tests/original-account-api-v2.test.mjs", "apps/mobile/tests/local-root-note-vault-v1.test.mjs"]
