#!/usr/bin/env bash
set -euo pipefail
task_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
task_helpers="$task_root/scripts/development"
task_node_dir="$task_root/.internal/dev/toolchains/node-v24.19.0-linux-x64/bin"
task_legacy_node_dir="$task_root/.internal/dev/toolchains/node-v24.14.0-linux-x64/bin"
task_flat="$task_root/.internal/runtime/omnichain-flat-profile/flat-wallet"
unset NODE_OPTIONS NODE_PATH
export PATH="$task_node_dir:$PATH"
task_command="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$task_command" in
  help|-h|--help) exec python3 -B "$task_helpers/workflow.py" help ;;
  lab)
    case "${1:-}" in
      profiles|plan|check|prepare-profile) exec python3 -B "$task_helpers/lab_profiles.py" "$@" ;;
    esac
    if [ "${1:-}" = "mobile-original-ledger" ]; then
      shift
      python3 -B "$task_helpers/workspace.py" --quiet
      exec python3 -B "$task_helpers/native_value_ledger.py" "$@"
    fi
    if [ "${1:-}" = "mobile-original" ]; then
      shift
      exec python3 -B "$task_helpers/paired_original_account_lab.py" "$@"
    fi
    if [ "${1:-}" = "audit-base" ]; then
      shift
      exec python3 "$task_helpers/empty_audit_lab.py" "$@"
    fi
    if [ "${1:-}" = "btc-sol" ]; then
      shift
      exec python3 "$task_helpers/btc_sol_lab.py" "$@"
    fi
    if [ "${1:-}" = "osaka" ]; then
      shift
      exec python3 "$task_helpers/osaka_lab.py" "$@"
    fi
    if [ "${1:-}" = "defi" ]; then
      shift
      exec python3 "$task_helpers/defi_entry_lab.py" "$@"
    fi
    if [ "${1:-}" = "metamorpho" ]; then
      shift
      exec python3 "$task_helpers/defi_lab.py" "$@"
    fi
    if [ "${1:-}" = "claims" ]; then
      shift
      exec python3 "$task_helpers/native_claim_lab.py" "$@"
    fi
    exec python3 "$task_helpers/evm_lab.py" "$@" ;;
  build)
    if [ "${1:-}" = "--legacy" ]; then shift; exec python3 -B "$task_helpers/workspace.py" "$@"; fi
    exec python3 -B "$task_helpers/source_runtime.py" "$@" ;;
  status) exec python3 -B "$task_helpers/workflow.py" status "$@" ;;
  prepare) exec python3 -B "$task_helpers/workflow.py" prepare "$@" ;;
  workflows) exec python3 -B "$task_helpers/workflow.py" catalog "$@" ;;
  boundaries) exec python3 -B "$task_helpers/module_boundaries.py" "$@" ;;
  block-check) exec python3 -B "$task_helpers/block_check.py" "$@" ;;
  static)
    python3 -B "$task_helpers/source_runtime.py" --quiet
    exec "$task_node_dir/node" --max-old-space-size=384 "$task_helpers/static-check.mjs" "$@" ;;
  platform|engine)
    case "${1:-}" in
      paged-native-new|paged-native-reopen|paged-mixed-new|paged-mixed-reopen)
        exec python3 -B "$task_helpers/paged_platform_process.py" "$@" ;;
    esac
    if [ "$task_command" = engine ]; then
      exec "$task_node_dir/node" --max-old-space-size=384 "$task_root/services/paeg-engine/src/entry.mjs" "$@"
    fi
    exec "$task_node_dir/node" --max-old-space-size=384 "$task_root/services/api-server/src/entry.mjs" "$@" ;;
  pins) exec python3 -B "$task_helpers/source_pins.py" "$@" ;;
  resources) exec python3 -B "$task_helpers/local_resources.py" "$@" ;;
  bundle) exec python3 -B "$task_helpers/source_bundle.py" "$@" ;;
  sources) exec python3 -B "$task_helpers/source_generations.py" "$@" ;;
  legacy)
    task_legacy_command="${1:-help}"
    if [ "$#" -gt 0 ]; then shift; fi
    case "$task_legacy_command" in
      build) exec python3 -B "$task_helpers/workspace.py" "$@" ;;
      node) exec python3 -B "$task_helpers/run_node.py" --legacy "$@" ;;
      test) exec python3 -B "$task_helpers/run_tests.py" --legacy "$@" ;;
      check)
        python3 -B "$task_helpers/workspace.py"
        python3 -B "$task_helpers/verify_layout.py"
        exec "$task_node_dir/node" "$task_helpers/smoke.mjs" "$@" ;;
      *) printf '%s\n' 'Uso: ./dev legacy [build|node|test|check]'; exit 2 ;;
    esac ;;
  clean) exec python3 -B "$task_helpers/clean.py" "$@" ;;
  start|api)
    python3 -B "$task_helpers/source_runtime.py" --quiet
    cd "$task_root"
    exec "$task_node_dir/node" services/api-server/src/wallet-entry.mjs "$@" ;;
  check)
    python3 -B "$task_helpers/source_runtime.py"
    python3 -B "$task_helpers/module_boundaries.py"
    "$task_node_dir/node" --max-old-space-size=384 "$task_helpers/static-check.mjs"
    python3 -B "$task_helpers/workflow.py" docs-check
    python3 -B "$task_helpers/test_source_runtime.py"
    exec python3 -B "$task_helpers/run_tests.py" "$@" ;;
  test)
    if [ "${1:-}" = "--changed" ] || [ "${1:-}" = "--component" ]; then
      exec python3 -B "$task_helpers/workflow.py" test "$@"
    fi
    exec python3 -B "$task_helpers/run_tests.py" "$@" ;;
  doctor) exec python3 "$task_helpers/doctor.py" "$@" ;;
  artifacts) exec python3 "$task_helpers/artifacts.py" "$@" ;;
  smoke) python3 "$task_helpers/workspace.py" --quiet; exec "$task_node_dir/node" "$task_helpers/smoke.mjs" "$@" ;;
  evidence|verify-restored) python3 "$task_helpers/workspace.py" --quiet; exec "$task_node_dir/node" "$task_helpers/verify_restored.mjs" "$@" ;;
  node) exec python3 "$task_helpers/run_node.py" "$@" ;;
  setup) python3 "$task_helpers/workspace.py" --quiet; exec python3 "$task_helpers/setup.py" "$@" ;;
  import) exec python3 "$task_helpers/import_public_backup.py" "$@" ;;
  canonical) python3 "$task_helpers/workspace.py" --quiet; exec python3 "$task_helpers/materialize_canonical.py" "$@" ;;
  legacy-node) export PATH="$task_legacy_node_dir:$PATH"; exec "$task_legacy_node_dir/node" "$@" ;;
  proof-node) exec "$task_node_dir/node" "$@" ;;
  npm) unset NPM_CONFIG_CACHE; export npm_config_cache="$task_root/.local/cache/npm"; exec "$task_node_dir/node" "$task_node_dir/../lib/node_modules/npm/bin/npm-cli.js" "$@" ;;
  *) printf 'Comando desconocido: %s. Consulta ./dev help\n' "$task_command" >&2; exit 2 ;;
esac
