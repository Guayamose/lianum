pub global VK_HASH: Field = 19413163071466834106590788125793335604274718922344765672794580580384743335999;

pub fn verify(proof: [Field; 458], inputs: [Field; 67]) {
    bb_honk_verifier::verify_honk_proof(VK, proof, inputs, VK_HASH);
    for i in 0..64 {
        let value = inputs[i] as u32;
        assert(value as Field == inputs[i]);
    }
    for i in 64..65 {
        let value = inputs[i] as u8;
        assert(value as Field == inputs[i]);
    }
    for i in 65..67 {
        let value = inputs[i] as u64;
        assert(value as Field == inputs[i]);
    }
}
