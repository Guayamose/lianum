pub fn verify(proof: [Field; 458], inputs: [Field; 50]) {
    bb_honk_verifier::verify_honk_proof(VK, proof, inputs, VK_HASH);
    for i in 0..48 {
        let value = inputs[i] as u32;
        assert(value as Field == inputs[i]);
    }
    for i in 48..50 {
        let value = inputs[i] as u64;
        assert(value as Field == inputs[i]);
    }
}
