// Bounded work under one root. A chunk is a proof relation, never a
// host accepted/complete flag. One edge or one node removes graph/degree caps.
use crate::{framing,graph};
use graph_support::sha256::words_to_bytes;
pub struct Progress {pub page_chain:[u8;32],pub node_chain:[u8;32],pub output_chain:[u8;32],pub spent_root:[u8;32],pub effect_root:[u8;32],pub receipt_frontier:[u8;32],pub edge_chain:[u8;32],pub active_node_digest:[u8;32],pub active_dependency_root:[u8;32],pub next_page:u64,pub next_node:u64,pub payout_sum:u64,pub next_edge:u64,pub last_dependency:u64,pub active_dependency_count:u64,pub revocation_sequence:u64,pub min_receipt_until:u64,pub max_receipt_from:u64,}
pub fn digest<let N:u32>(p:[Field;N],offset:u32)->[u8;32]{let mut w:[u32;8]=[0;8];for i in 0..8{w[i]=p[offset+i] as u32;assert(w[i] as Field==p[offset+i]);}words_to_bytes(w)}
pub fn scalar<let N:u32>(p:[Field;N],offset:u32)->u64{let v=p[offset] as u64;assert(v as Field==p[offset]);v}
pub fn accumulator(domain:[u8;32],auth:[u8;32],nf:[u8;32],v:Progress)->[u8;32]{framing::accumulator(domain,auth,nf,v.next_page,v.next_node,v.payout_sum,v.next_edge,v.last_dependency,v.active_dependency_count,v.revocation_sequence,v.min_receipt_until,v.max_receipt_from,v.page_chain,v.node_chain,v.output_chain,v.spent_root,v.effect_root,v.receipt_frontier,v.edge_chain,v.active_node_digest,v.active_dependency_root)}
// Blinding is generated by the original job producer from CSPRNG bytes. The
// proof binds it; no deterministic cursor/dependency digest is public.
pub fn commitment(domain:[u8;32],auth:[u8;32],nf:[u8;32],v:Progress,blinding:[u8;32])->[u8;32]{assert(blinding!=[0;32]);framing::private_progress(domain,auth,nf,accumulator(domain,auth,nf,v),blinding)}
pub fn ready(domain:[u8;32],auth:[u8;32],nf:[u8;32],c:[u8;32],blinding:[u8;32])->[u8;32]{assert(blinding!=[0;32]);framing::private_ready(domain,auth,nf,c,blinding)}
pub fn initial(s:graph::Statement,sequence:u64)->Progress{Progress{page_chain:framing::empty_pages(s.context),node_chain:framing::empty_nodes(s.context),output_chain:framing::empty_outputs(s.context),spent_root:framing::empty_spent(s.authorization_root),effect_root:framing::empty_effects(s.authorization_root),receipt_frontier:graph::empty_root(3),edge_chain:framing::empty_dependencies(s.context,0),active_node_digest:[0;32],active_dependency_root:[0;32],next_page:0,next_node:0,payout_sum:0,next_edge:0,last_dependency:0,active_dependency_count:0,revocation_sequence:sequence,min_receipt_until:18446744073709551615,max_receipt_from:0}}
pub fn same_economic_prefix(a:Progress,b:Progress){assert(a.next_page==b.next_page);assert(a.next_node==b.next_node);assert(a.payout_sum==b.payout_sum);assert(a.revocation_sequence==b.revocation_sequence);assert(a.min_receipt_until==b.min_receipt_until);assert(a.max_receipt_from==b.max_receipt_from);assert(a.page_chain==b.page_chain);assert(a.node_chain==b.node_chain);assert(a.output_chain==b.output_chain);assert(a.spent_root==b.spent_root);assert(a.effect_root==b.effect_root);assert(a.receipt_frontier==b.receipt_frontier);}
pub fn assert_node(s:graph::Statement,n:graph::Node,path:[[u8;32];64],v:Progress){assert(n.ordinal==v.next_node);assert(n.ordinal<s.nodes);let cm=graph::node_digest(n);graph::member(1,cm,n.ordinal,path,s.nodes_commitment);}
