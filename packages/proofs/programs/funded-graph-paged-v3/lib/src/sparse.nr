// Own V3 sparse-tree domain. Original SHA framing, PC23/nullifiers and
// signatures remain byte-exact. Every raw digest is TWO full u128 limbs.
use poseidon::poseidon2::Poseidon2;
global PROFILE:Field=0x4c49414e554d5f50414745445f545245455f50325f5633;
global MODULUS:[u8;32]=[0x30,0x64,0x4e,0x72,0xe1,0x31,0xa0,0x29,0xb8,0x50,0x45,0xb6,0x81,0x81,0x58,0x5d,0x28,0x33,0xe8,0x48,0x79,0xb9,0x70,0x91,0x43,0xe1,0xf5,0x93,0xf0,0x00,0x00,0x01];
pub fn raw_limbs(bytes:[u8;32])->[Field;2]{let mut hi:u128=0;let mut lo:u128=0;for i in 0..16{hi=hi*256+(bytes[i] as u128);lo=lo*256+(bytes[i+16] as u128);}[hi as Field,lo as Field]}
// Compare ORIGINAL bytes against r before reconstruction, as in the frozen
// original arithmetic codec. Neither r nor any x+r alias is accepted.
pub fn canonical(bytes:[u8;32])->Field{let mut equal=true;let mut less=false;for i in 0..32{less=less | (equal & (bytes[i]<MODULUS[i]));equal=equal & (bytes[i]==MODULUS[i]);}assert(less);let limbs=raw_limbs(bytes);limbs[0]*340282366920938463463374607431768211456+limbs[1]}
fn empty_field(kind:u8)->Field{assert(kind<5);Poseidon2::hash([PROFILE,3,1,1,kind as Field],5)}
fn parent(kind:u8,level:u32,left:Field,right:Field)->Field{assert(kind<5);assert(level>0);assert(level<=64);Poseidon2::hash([PROFILE,3,3,4,kind as Field,level as Field,left,right],8)}
pub fn empty(kind:u8)->[u8;32]{empty_field(kind).to_be_bytes::<32>()}
pub fn leaf(kind:u8,digest:[u8;32])->[u8;32]{assert(kind<5);let limbs=raw_limbs(digest);Poseidon2::hash([PROFILE,3,2,3,kind as Field,limbs[0],limbs[1]],7).to_be_bytes::<32>()}
pub fn empty_root(kind:u8)->[u8;32]{let mut value=empty_field(kind);for d in 0..64{value=parent(kind,d+1,value,value);}value.to_be_bytes::<32>()}
// Carry canonical Field parents internally; encode only the final root.
pub fn root(kind:u8,encoded_leaf:[u8;32],ordinal:u64,siblings:[[u8;32];64])->[u8;32]{let mut value=canonical(encoded_leaf);for d in 0..64{let sibling=canonical(siblings[d]);value=if ((ordinal>>(d as u64))&1)==0{parent(kind,d+1,value,sibling)}else{parent(kind,d+1,sibling,value)};}value.to_be_bytes::<32>()}

// Synthetic conformance vectors from the unchanged original Solidity
// permutation. These are source tests, not an issued VK/proof.
#[test]
fn independent_sparse_math_vectors(){
 assert(empty(0)==[0x00,0xe8,0xe3,0x7a,0xdd,0x0a,0x96,0x23,0xae,0x31,0xeb,0x0a,0xba,0x91,0xfe,0x25,0x10,0xad,0x6d,0xc2,0x83,0xde,0x68,0x70,0xd0,0xd0,0xa3,0x8b,0xa0,0x9a,0x11,0x0d]);
 assert(empty(1)==[0x17,0x0d,0xd8,0xd9,0x05,0x9d,0xb0,0x0b,0x1a,0x1e,0xa8,0xc7,0xaa,0xae,0xe8,0x80,0x41,0x3d,0xa6,0x8e,0x6c,0x63,0x41,0x53,0xbc,0x1e,0x9d,0xe7,0xd7,0xce,0x17,0x7c]);
 assert(empty(2)==[0x16,0x8c,0xbf,0xa1,0x0d,0x24,0x0c,0x9c,0xf2,0x1a,0xf8,0x4b,0x1d,0xad,0x10,0xf0,0x82,0xff,0xf1,0xd6,0x5e,0x8f,0x16,0xaa,0x08,0x55,0xed,0xd0,0x82,0xd1,0x5b,0x4e]);
 assert(empty(3)==[0x24,0x25,0x5a,0x9e,0xbb,0x0b,0xa4,0x45,0x52,0x26,0x6a,0x51,0x86,0x25,0x4a,0x94,0xf1,0xf1,0x71,0x76,0xd4,0xc7,0x61,0xc1,0x3d,0xbe,0x43,0x41,0xda,0x32,0x56,0xb2]);
 assert(empty(4)==[0x2b,0x70,0xa9,0xa8,0xb6,0x23,0x45,0x5c,0x18,0xb3,0x13,0x82,0x0e,0xa3,0x5e,0x5c,0x5b,0xa8,0xc2,0xdc,0x24,0x0e,0x08,0x55,0x96,0x6e,0x4f,0xaf,0x96,0xf8,0xe0,0x82]);
