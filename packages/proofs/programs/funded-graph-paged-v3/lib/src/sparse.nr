 assert(leaf(1,[0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00])==[0x18,0x8c,0x3f,0x15,0x54,0xcd,0x92,0x05,0x4d,0xff,0xf6,0xb3,0xeb,0x05,0x24,0xd2,0x15,0x19,0x44,0xa6,0x13,0xa4,0x18,0xe5,0x7d,0x68,0x60,0x08,0x3d,0xef,0xb8,0x48]);
 assert(leaf(2,[0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff])==[0x22,0x46,0xb2,0x18,0xc9,0xf4,0x4a,0x22,0x34,0xd5,0x2e,0xdc,0x36,0xcd,0x34,0x4f,0xd2,0xfa,0xc0,0xa9,0x0f,0x18,0x90,0x08,0x27,0x0f,0xa7,0x1c,0xe5,0x9c,0x44,0x4c]);
