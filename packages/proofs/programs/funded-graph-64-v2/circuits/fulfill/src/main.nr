use profile64::{graph,framing};
use graph_support::sha256::words_to_bytes;
use native_support::{receipt,state};
fn main(domain_commitment:pub [u32;8],authorization_root:pub [u32;8],reserve_nullifier:pub [u32;8],evidence_state:pub [u32;8],output_root:pub [u32;8],outputs:pub [[u32;8];64],terminal_tags:pub [[u32;8];64],valid_from:pub u64,valid_until:pub u64,witness:graph::Witness,state_opening:state::EvidenceState,receipts:[receipt::ReceiptRead;64],receipt_spend_secrets:[[u8;32];64],receipt_siblings:[[[u8;32];6];64],receipt_indices:[u32;64],revoked_entries:[[u8;32];64]){
 let s=witness.statement;assert(graph::domain(s)==words_to_bytes(domain_commitment));assert(s.authorization_root==words_to_bytes(authorization_root));assert(s.reserve_nullifier==words_to_bytes(reserve_nullifier));assert(s.output_root==words_to_bytes(output_root));assert(valid_from<valid_until);assert(valid_until<=s.settle_before);
 let proved_outputs=graph::assert_authorization(witness);assert(state_opening.hub_domain==s.hub_domain);assert(state_opening.registry_commitment==s.registry_commitment);assert(state::evidence_state_digest(state_opening)==words_to_bytes(evidence_state));assert(state::bounded_list_digest(0x32,s.hub_domain,revoked_entries,state_opening.revoked_count)==state_opening.revoked_digest);
 for i in 0..64{assert(proved_outputs[i]==words_to_bytes(outputs[i]));let tag=words_to_bytes(terminal_tags[i]);assert(tag!=[0;32]);for j in 0..64{if j<i{assert(tag!=words_to_bytes(terminal_tags[j]));}}
  if i<witness.active_count{let r=receipts[i];let n=witness.nodes[i];for j in 0..64{if j<i{assert(r.global_effect_id!=receipts[j].global_effect_id);}}assert(r.hub_domain==s.hub_domain);assert(r.registry_commitment==s.registry_commitment);assert(r.scope==s.scope);assert(r.policy==s.policy);assert(r.local_commitment==n.local_commitment);assert(r.dispatch_id==n.dispatch_id);assert(r.chain_domain==n.chain_domain);assert(r.evidence_policy==n.evidence_policy);assert(r.action_commitment==n.action_commitment);assert(r.payout_commitment==n.payout_commitment);assert(r.receipt_key_commitment==n.receipt_key_commitment);assert(r.receipt_rho==n.receipt_rho);assert(r.valid_from<=valid_from);assert(valid_until<=r.valid_until);assert(receipt_indices[i]<state_opening.receipt_count);state::membership(receipt::receipt_commitment(r),receipt_siblings[i],receipt_indices[i],state_opening.receipt_root);for j in 0..64{if j<state_opening.revoked_count{assert(r.global_effect_id!=revoked_entries[j]);}}assert(tag==receipt::receipt_nullifier(r,receipt_spend_secrets[i]));
  }else{profile64::receipt_helpers::empty_receipt(receipts[i]);assert(receipt_spend_secrets[i]==[0;32]);assert(receipt_siblings[i]==[[0;32];6]);assert(receipt_indices[i]==0);assert(tag==framing::padding_terminal(s.authorization_root,i as u8,witness.padding_salts[i]));}
 }
}
