{
  "name": "@lianum/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node src/entry.mjs",
    "db:migrate": "node src/migrate.mjs",
    "db:migrate:original-device": "node src/migrate-original-device-v1.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "start:original": "node --max-old-space-size=384 src/entry.mjs original-native-new",
    "reopen:original": "node --max-old-space-size=384 src/entry.mjs original-native-reopen",
    "start:paged-native": "node --max-old-space-size=384 src/entry.mjs paged-native-new",
    "start:paged-mixed": "node --max-old-space-size=384 src/entry.mjs paged-mixed-new",
    "reopen:paged-native": "node --max-old-space-size=384 src/entry.mjs paged-native-reopen",
    "reopen:paged-mixed": "node --max-old-space-size=384 src/entry.mjs paged-mixed-reopen"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
