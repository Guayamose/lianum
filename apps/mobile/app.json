{
  "expo": {
    "name": "Lianum",
    "slug": "lianum-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lianum",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "org.lianum.wallet",
      "supportsTablet": false
    },
    "android": {
      "package": "org.lianum.wallet",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/design/assets/android-icon-foreground.png",
        "backgroundImage": "./src/design/assets/android-icon-background.png",
        "monochromeImage": "./src/design/assets/android-icon-monochrome.png",
        "backgroundColor": "#F3F0E8"
      },
      "googleServicesFile": "./.local/firebase/google-services.json",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/with-native-build-limits.cjs",
      "./plugins/with-paged-pinned-tls.cjs",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Lianum necesita Face ID para proteger tu clave y confirmar las autorizaciones que revisas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirma tu identidad antes de crear o utilizar tu clave de Lianum."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Lianum necesita el micr\u00f3fono para hablar con tu agente.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Lianum necesita el micr\u00f3fono para hablar con tu agente.",
          "cameraPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/design/assets/android-icon-monochrome.png",
          "color": "#315C60",
          "defaultChannel": "lianum-agent"
        }
      ]
    ],
    "backgroundColor": "#F3F0E8",
    "icon": "./src/design/assets/icon.png"
  }
}
