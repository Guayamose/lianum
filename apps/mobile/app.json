{
  "expo": {
    "name": "Lianum",
    "slug": "lianum-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lianum",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "org.lianum.wallet",
      "supportsTablet": false
    },
    "android": {
      "package": "org.lianum.wallet",
      "allowBackup": false
    },
    "plugins": [
      "./plugins/with-native-build-limits.cjs",
      "./plugins/with-paged-pinned-tls.cjs",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Lianum necesita Face ID para proteger tu clave y confirmar las autorizaciones que revisas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirma tu identidad antes de crear o utilizar tu clave de Lianum."
        }
      ]
    ],
    "backgroundColor": "#F4F7FB"
  }
}
