{
  "name": "@lianum/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "prebuild": "expo prebuild --no-install --platform all",
    "export": "expo export --max-workers 2 --platform all --output-dir dist"
  },
  "dependencies": {
    "@lianum/mobile-protocol": "file:../../packages/mobile-protocol",
    "@noble/curves": "2.4.0",
    "expo": "57.0.27",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-local-authentication": "57.0.3",
    "expo-secure-store": "57.0.4",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "typescript": "6.0.3"
  },
  "engines": { "node": ">=24.19.0" },
  "overrides": { "xcode": { "uuid": "11.1.1" } }
}
