pragma solidity 0.8.37;
import {FlatVerifierSet,IFlatProofVerifier} from "./FlatVerifierSet.sol";
import {FlatHubCodec} from "./FlatHubCodec.sol";
import {PagedSparsePoseidon2V3} from "./crypto/PagedSparsePoseidon2V3.sol";
interface IPagedGraphReadV3 {function domain() external view returns(bytes32);function isOriginalReady(bytes32,bytes32,bytes32) external view returns(bool);function globalCutoff(bytes32) external view returns(uint64);}
/// Append-only original native facts, new V3 ledger; no bounded64 adoption.
/// Admission authenticates registered rule/provider/quorum with NEW A3 VK.
/// Revocations invalidate the entire fold epoch. It is federated attestation,
/// not independent chain consensus or RPC anonymity.
contract PrivatePagedFundedGraphNativeStateV3 {
 string public constant PROFILE="LIANUM_PAEG_FUNDED_PAGED_V3";
 address public immutable graphState;bytes32 public graphStateCodeHash;bytes32 public immutable domain;
 bytes32 public immutable hubDomain;bytes32 public immutable registryCommitment;
 address public immutable hubCodec;bytes32 public immutable hubCodecCodeHash;
 address public immutable sparseMath;bytes32 public immutable sparseMathCodeHash;
 bytes32 public immutable artifactManifest;FlatVerifierSet.Pin private admissionVerifier;
 address[4] private attesters;uint64 public receiptCount;uint64 public revocationSequence;uint64 public stateSequence;bool public halted;bytes32 public evidenceState;
 struct Receipt {bytes32 authorization;bytes32 gid;uint64 validFrom;uint64 validUntil;}
 mapping(bytes32=>Receipt) private receipts;mapping(bytes32=>bool) public admittedEffects;mapping(bytes32=>bool) public revoked;
 bytes32 public receiptRoot;bytes32[65] private receiptEmpty;mapping(bytes32=>bytes32) private receiptTree;mapping(uint64=>bool) private occupiedReceiptSlots;
 uint256 private entered;
 event ReceiptAdmitted(bytes32 indexed authorization,bytes32 commitment,bytes32 gid,uint64 index);
 event ReceiptRevoked(bytes32 indexed gid,bytes32 reason,uint64 sequence);
 modifier exclusive(){require(entered==0,"PAGED_NATIVE_REENTRANT");entered=1;_;entered=0;}
 struct Deployment {address state;bytes32 stateCodeHash;bytes32 graphDomain;bytes32 hub;bytes32 registry;uint64 registryEpoch;bytes32 rulesRoot;uint256[4] attesterX;uint256[4] attesterY;address codec;bytes32 codecCodeHash;address math;bytes32 mathCodeHash;bytes32 manifest;FlatVerifierSet.Pin newAdmissionV3;}
 constructor(Deployment memory c){require(c.state!=address(0)&&c.stateCodeHash!=bytes32(0)&&c.stateCodeHash!=keccak256("")&&c.graphDomain!=bytes32(0)&&c.hub!=bytes32(0)&&c.registry!=bytes32(0)&&c.manifest!=bytes32(0),"PAGED_NATIVE_DEPLOYMENT");graphState=c.state;graphStateCodeHash=c.stateCodeHash;domain=c.graphDomain;hubDomain=c.hub;registryCommitment=c.registry;artifactManifest=c.manifest;
 FlatVerifierSet.requireCode(c.codec,c.codecCodeHash);hubCodec=c.codec;hubCodecCodeHash=c.codecCodeHash;require(c.math==address(PagedSparsePoseidon2V3),"PAGED_SPARSE_LIBRARY_LINK");FlatVerifierSet.requireCode(c.math,c.mathCodeHash);sparseMath=c.math;sparseMathCodeHash=c.mathCodeHash;FlatVerifierSet.requireCode(c.newAdmissionV3.verifier,c.newAdmissionV3.codeHash);admissionVerifier=c.newAdmissionV3;require(FlatHubCodec.registryCommitment(c.hub,c.registryEpoch,c.rulesRoot,c.attesterX,c.attesterY)==c.registry,"PAGED_NATIVE_REGISTRY");for(uint256 i=0;i<4;++i){address a=FlatHubCodec.attesterAddress(c.attesterX[i],c.attesterY[i]);for(uint256 j=0;j<i;++j)require(a!=attesters[j]&&c.attesterX[i]!=c.attesterX[j],"PAGED_NATIVE_DUPLICATE_ATTESTER");attesters[i]=a;}receiptEmpty[0]=PagedSparsePoseidon2V3.empty(4);for(uint8 i=0;i<64;++i)receiptEmpty[i+1]=_receiptBranch(i+1,receiptEmpty[i],receiptEmpty[i]);receiptRoot=receiptEmpty[64];_record();}
 function graphProfileHash() external pure returns(bytes32){return keccak256(bytes(PROFILE));}
 function admit(bytes calldata proof,bytes32[] calldata p,uint64 from,uint64 until,FlatHubCodec.QuorumSignature[3] calldata health) external exclusive {
 FlatVerifierSet.requireCode(graphState,graphStateCodeHash);require(IPagedGraphReadV3(graphState).domain()==domain,"PAGED_NATIVE_DOMAIN");require(!halted&&p.length==85&&_digest(p,0)==domain,"PAGED_NATIVE_ADMISSION_DOMAIN");bytes32 auth=_digest(p,8);require(IPagedGraphReadV3(graphState).isOriginalReady(auth,_digest(p,24),_digest(p,77)),"PAGED_NATIVE_READY_REQUIRED");require(_u64(p[72])==revocationSequence,"PAGED_NATIVE_REVOCATION_CHANGED");_window(_u64(p[73]),_u64(p[74]));require(_u64(p[74])<=IPagedGraphReadV3(graphState).globalCutoff(auth),"PAGED_NATIVE_CUTOFF");verifyFinalityHealth(from,until,health);
 bytes32 cm=_digest(p,48);bytes32 gid=_digest(p,56);bytes32 nf=_digest(p,64);require(cm!=bytes32(0)&&gid!=bytes32(0)&&nf==_hash("admission-nullifier",bytes.concat(_part(abi.encodePacked(hubDomain)),_part(abi.encodePacked(gid))))&&!admittedEffects[nf]&&!revoked[gid]&&receipts[cm].authorization==bytes32(0),"PAGED_NATIVE_EFFECT_ALREADY_ADMITTED");uint64 receiptFrom=_u64(p[75]);uint64 receiptUntil=_u64(p[76]);require(receiptFrom<=_u64(p[73])&&_u64(p[74])<=receiptUntil,"PAGED_NATIVE_RECEIPT_WINDOW");FlatVerifierSet.requireCode(admissionVerifier.verifier,admissionVerifier.codeHash);require(IFlatProofVerifier(admissionVerifier.verifier).verify(proof,p),"PAGED_NATIVE_ADMISSION_PROOF");admittedEffects[nf]=true;receipts[cm]=Receipt(auth,gid,receiptFrom,receiptUntil);_insertReceipt(cm,_hash("admitted-receipt",bytes.concat(_part(abi.encodePacked(auth)),_part(abi.encodePacked(cm)),_part(abi.encodePacked(gid)),_part(abi.encodePacked(receiptFrom)),_part(abi.encodePacked(receiptUntil)))));uint64 index=receiptCount++;++stateSequence;_record();emit ReceiptAdmitted(auth,cm,gid,index);
 }
 function isCurrentEvidence(bytes32 evidence,uint64 sequence) external view returns(bool){return !halted&&evidence==evidenceState&&sequence==revocationSequence&&graphState.codehash==graphStateCodeHash;}
 function isCurrentReceipt(bytes32 auth,bytes32 cm,bytes32 gid,uint64 sequence,uint64 from,uint64 until) external view returns(bool){Receipt storage r=receipts[cm];return !halted&&graphState.codehash==graphStateCodeHash&&r.authorization==auth&&auth!=bytes32(0)&&r.gid==gid&&!revoked[gid]&&sequence==revocationSequence&&from<until&&from<=block.timestamp&&block.timestamp<until&&r.validFrom<=from&&until<=r.validUntil;}
 function receiptWindow(bytes32 cm) external view returns(uint64,uint64){Receipt storage r=receipts[cm];require(r.authorization!=bytes32(0),"PAGED_NATIVE_UNKNOWN_RECEIPT");return(r.validFrom,r.validUntil);}
 function revoke(bytes32 gid,uint64 expectedSequence,bytes32 reason,uint64 expiresAt,FlatHubCodec.QuorumSignature[3] calldata signatures) external exclusive returns(bool){require(gid!=bytes32(0)&&reason!=bytes32(0),"PAGED_NATIVE_REVOCATION_FIELDS");if(revoked[gid])return false;require(expectedSequence==revocationSequence&&block.timestamp<expiresAt,"PAGED_NATIVE_REVOCATION_EXPIRED");_quorum(_hash("revoke",bytes.concat(_part(abi.encodePacked(hubDomain)),_part(abi.encodePacked(registryCommitment)),_part(abi.encodePacked(gid)),_part(abi.encodePacked(expectedSequence)),_part(abi.encodePacked(reason)),_part(abi.encodePacked(expiresAt)))),signatures);revoked[gid]=true;++revocationSequence;++stateSequence;_record();emit ReceiptRevoked(gid,reason,revocationSequence);return true;}
 function verifyFinalityHealth(uint64 from,uint64 until,FlatHubCodec.QuorumSignature[3] calldata signatures) public view returns(bool){require(!halted,"PAGED_NATIVE_HALTED");_window(from,until);require(until-from<=30,"PAGED_NATIVE_HEALTH_WINDOW");_quorum(_hash("health",bytes.concat(_part(abi.encodePacked(domain)),_part(abi.encodePacked(hubDomain)),_part(abi.encodePacked(registryCommitment)),_part(abi.encodePacked(evidenceState)),_part(abi.encodePacked(revocationSequence)),_part(abi.encodePacked(stateSequence)),_part(abi.encodePacked(from)),_part(abi.encodePacked(until)))),signatures);return true;}
 function verifierPin() external view returns(address,bytes32){return(admissionVerifier.verifier,admissionVerifier.codeHash);}
 function _record() private {evidenceState=_hash("native-evidence",bytes.concat(_part(abi.encodePacked(domain)),_part(abi.encodePacked(hubDomain)),_part(abi.encodePacked(registryCommitment)),_part(abi.encodePacked(receiptCount)),_part(abi.encodePacked(revocationSequence)),_part(abi.encodePacked(stateSequence)),_part(abi.encodePacked(uint8(halted?1:0))),_part(abi.encodePacked(receiptRoot))));}
 // Fixed sparse address is derived from the original full CM. A 64-bit slot
 // collision is denied; no receipt replacement or reindex authority exists.
 function _receiptKey(uint8 depth,uint64 index) private pure returns(bytes32){return keccak256(abi.encodePacked(depth,index));}
 function _receiptBranch(uint8 level,bytes32 left,bytes32 right) private view returns(bytes32){FlatVerifierSet.requireCode(sparseMath,sparseMathCodeHash);return PagedSparsePoseidon2V3.branch(4,level,left,right);}
 function _receiptAt(uint8 depth,uint64 index) private view returns(bytes32){bytes32 value=receiptTree[_receiptKey(depth,index)];return value==bytes32(0)?receiptEmpty[depth]:value;}
 function _insertReceipt(bytes32 cm,bytes32 rawLeaf) private {FlatVerifierSet.requireCode(sparseMath,sparseMathCodeHash);bytes32 leaf=PagedSparsePoseidon2V3.leaf(4,rawLeaf);uint64 index=uint64(uint256(cm));require(!occupiedReceiptSlots[index],"PAGED_NATIVE_RECEIPT_SLOT_COLLISION");occupiedReceiptSlots[index]=true;receiptTree[_receiptKey(0,index)]=leaf;for(uint8 depth=0;depth<64;++depth){uint64 parent=index>>1;bytes32 left=_receiptAt(depth,parent<<1);bytes32 right=_receiptAt(depth,(parent<<1)|1);receiptTree[_receiptKey(depth+1,parent)]=_receiptBranch(depth+1,left,right);index=parent;}receiptRoot=_receiptAt(64,0);}
 function receiptSiblings(bytes32 cm) external view returns(bytes32[64] memory path){require(receipts[cm].authorization!=bytes32(0),"PAGED_NATIVE_UNKNOWN_RECEIPT");uint64 index=uint64(uint256(cm));for(uint8 depth=0;depth<64;++depth){path[depth]=_receiptAt(depth,index^1);index>>=1;}}
 function _quorum(bytes32 digest,FlatHubCodec.QuorumSignature[3] calldata signatures) private view {FlatVerifierSet.requireCode(hubCodec,hubCodecCodeHash);FlatHubCodec.assertQuorum(digest,signatures,attesters);}
 function _hash(string memory tag,bytes memory body) private pure returns(bytes32){return sha256(bytes.concat(_part(bytes(string.concat("LIANUM/PAEG/paged/",tag,"/3"))),_part(bytes(PROFILE)),body));}
 function _part(bytes memory v) private pure returns(bytes memory){return bytes.concat(abi.encodePacked(uint32(v.length)),v);}
 function _window(uint64 from,uint64 until) private view {require(from<until&&from<=block.timestamp&&block.timestamp<until,"PAGED_NATIVE_OUTSIDE_WINDOW");}
 function _u64(bytes32 v) private pure returns(uint64){require(uint256(v)<=type(uint64).max,"PAGED_NATIVE_U64");return uint64(uint256(v));}
 function _digest(bytes32[] calldata p,uint256 at) private pure returns(bytes32){uint256 x;for(uint256 i=0;i<8;++i){require(uint256(p[at+i])<=type(uint32).max,"PAGED_NATIVE_U32");x=(x<<32)|uint32(uint256(p[at+i]));}return bytes32(x);}
}
