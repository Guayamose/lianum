const sha=b=>createHash('sha256').update(b).digest('hex');
function project(){let p=dirname(fileURLToPath(import.meta.url));for(let i=0;i<16;i++,p=dirname(p)){try{const q=join(p,'scripts/layout.json'),s=lstatSync(q);if(s.isFile()&&!s.isSymbolicLink()&&realpathSync(p)===p)return p;}catch(e){if(e.code!=='ENOENT')throw e;}}assert.fail('PAGED_GRAPH_PHYSICAL_PROJECT');}
export function assertOriginalDevicePagedGraphSourceV3(){assert.equal(arguments.length,0);assert.ok(rows.length>0,'PAGED_GRAPH_SOURCE_UNREVIEWED');const root=project();for(const row of rows){for(const slot of ['canonical','generated']){const p=row[slot];if(p===null)continue;const path=resolve(root,p.path);assert.ok(path.startsWith(root+'/'));const stat=lstatSync(path);assert.ok(stat.isFile()&&!stat.isSymbolicLink()&&realpathSync(path)===path&&stat.size===p.bytes,'PAGED_GRAPH_PHYSICAL_SOURCE_CHANGED');const bytes=readFileSync(path);try{assert.equal(sha(bytes),p.sha256,'PAGED_GRAPH_REVIEWED_SOURCE_CHANGED');}finally{bytes.fill(0);}}}return Object.freeze({profile:'DEVICE_PAGED_PRIVATE_GRAPH_SOURCE_V3',sources:rows.length,sourceSHA256:sha(JSON.stringify(rows))});}
