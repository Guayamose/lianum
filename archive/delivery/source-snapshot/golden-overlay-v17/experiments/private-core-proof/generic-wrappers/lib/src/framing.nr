// Generated by generic-wrappers/generate.mjs; fixed profile, no witness specialization.
// Every H4 component, including the tag, has a u32BE byte-length prefix.
use generic_graph::sha256::{sha256, u32_bytes, words_to_bytes};

fn part<let N: u32, let M: u32>(buffer: [u8; N], offset: u32, value: [u8; M]) -> [u8; N] {
    let mut result = buffer;
    let length = u32_bytes(M);
    for i in 0..4 { result[offset + i] = length[i]; }
    for i in 0..M { result[offset + 4 + i] = value[i]; }
    result
}

// LIANUM/PAEG/reservation-admission/1
pub fn admission(scope: [u32; 8], policy: [u32; 8], asset: [u32; 8], operation_id: [u32; 8]) -> [u32; 8] {
    let mut message: [u8; 210] = [0; 210];
    message = part(message, 0, [76, 73, 65, 78, 85, 77, 47, 80, 65, 69, 71, 47, 114, 101, 115, 101, 114, 118, 97, 116, 105, 111, 110, 45, 97, 100, 109, 105, 115, 115, 105, 111, 110, 47, 49]);
    message = part(message, 39, [76, 73, 65, 78, 85, 77, 95, 80, 65, 69, 71, 95, 70, 85, 78, 68, 69, 68, 95, 52, 95, 86, 49]);
    message = part(message, 66, words_to_bytes(scope));
    message = part(message, 102, words_to_bytes(policy));
    message = part(message, 138, words_to_bytes(asset));
    message = part(message, 174, words_to_bytes(operation_id));
    let digest = sha256::<210, 256>(message);
    let mut words: [u32; 8] = [0; 8];
    for i in 0..8 {
        words[i] = (digest[i * 4] as u32 << 24) | (digest[i * 4 + 1] as u32 << 16)
            | (digest[i * 4 + 2] as u32 << 8) | digest[i * 4 + 3] as u32;
    }
    words
}
