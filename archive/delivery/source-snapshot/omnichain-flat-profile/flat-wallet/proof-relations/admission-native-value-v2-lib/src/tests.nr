fn union_evm_profile() { assert(union::profile_commitment([216, 71, 103, 183, 205, 143, 155, 146, 138, 188, 241, 147, 230, 65, 154, 97, 88, 162, 171, 22, 15, 151, 78, 176, 32, 124, 135, 138, 141, 200, 5, 232], profile(), empty_tron()) == [240, 248, 69, 186, 27, 255, 58, 201, 137, 132, 110, 39, 17, 103, 36, 24, 227, 116, 136, 117, 210, 35, 46, 130, 164, 248, 129, 179, 167, 76, 39, 154]); }

