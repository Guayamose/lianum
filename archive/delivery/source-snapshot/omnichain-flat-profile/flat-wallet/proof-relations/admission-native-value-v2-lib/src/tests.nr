fn union_tron_profile() { assert(union::profile_commitment([37, 81, 71, 43, 131, 215, 219, 152, 112, 18, 133, 218, 159, 21, 30, 31, 34, 199, 177, 61, 197, 207, 190, 163, 92, 223, 29, 18, 143, 204, 239, 84], empty_evm(), tron_profile()) == [179, 52, 51, 233, 95, 154, 51, 150, 33, 101, 8, 64, 123, 42, 91, 201, 8, 164, 181, 190, 133, 42, 243, 178, 115, 13, 137, 27, 149, 203, 160, 2]); }

#[test(should_fail)]
fn rejects_unknown_union_selector() { let _cm = union::profile_commitment([0; 32], profile(), empty_tron()); }

#[test(should_fail)]
fn rejects_nonzero_inactive_tron() { let mut p = empty_tron(); p.version = 1; let _cm = union::profile_commitment([216, 71, 103, 183, 205, 143, 155, 146, 138, 188, 241, 147, 230, 65, 154, 97, 88, 162, 171, 22, 15, 151, 78, 176, 32, 124, 135, 138, 141, 200, 5, 232], profile(), p); }

#[test(should_fail)]
fn rejects_nonzero_inactive_evm() { let mut p = empty_evm(); p.chain_id = 1; let _cm = union::profile_commitment([37, 81, 71, 43, 131, 215, 219, 152, 112, 18, 133, 218, 159, 21, 30, 31, 34, 199, 177, 61, 197, 207, 190, 163, 92, 223, 29, 18, 143, 204, 239, 84], p, tron_profile()); }

#[test(should_fail)]
fn rejects_tron_padding() { let mut e = tron_effect(); e.transaction_id[63] = 1; let _gid = tron::assert_native_facts(tron_profile(), e, tron_wire(), tron_observed(), tron_evidence()); }

#[test(should_fail)]
fn rejects_tron_permission_policy() { let mut p = tron_profile(); p.permission_policy = [0; 32]; tron::assert_profile(p); }
