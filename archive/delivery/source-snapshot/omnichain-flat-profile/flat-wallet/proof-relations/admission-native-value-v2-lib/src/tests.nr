#[test]
fn profile_byte_vector() {
    assert(framing::profile_commitment(profile()) == [240, 248, 69, 186, 27, 255, 58, 201, 137, 132, 110, 39, 17, 103, 36, 24, 227, 116, 136, 117, 210, 35, 46, 130, 164, 248, 129, 179, 167, 76, 39, 154]);
}

#[test]
fn source_byte_vector() {
    assert(framing::source_commitment(source()) == [37, 217, 3, 105, 2, 91, 125, 222, 10, 78, 251, 230, 243, 66, 111, 167, 97, 132, 217, 155, 24, 39, 173, 107, 69, 183, 57, 128, 41, 167, 42, 35]);
}

#[test]
fn registry_byte_vector() {
    assert(framing::registry_commitment(registry()) == [88, 37, 202, 14, 183, 149, 139, 230, 118, 85, 233, 30, 200, 6, 43, 142, 188, 143, 191, 9, 198, 42, 158, 211, 254, 36, 215, 244, 54, 57, 13, 31]);
}

#[test]
fn chain_byte_vector() {
    assert(framing::chain_domain(profile()) == [92, 247, 19, 164, 12, 48, 198, 193, 4, 109, 150, 226, 100, 70, 72, 146, 103, 243, 32, 15, 11, 240, 131, 110, 247, 2, 147, 97, 129, 118, 202, 117]);
}

#[test]
fn facts_byte_vector() {
    assert(framing::facts_statement(domain(), 7, profile(), effect(), [65, 212, 186, 131, 95, 82, 245, 89, 39, 18, 171, 211, 56, 196, 165, 244, 252, 68, 202, 73, 25, 46, 194, 83, 71, 37, 190, 72, 173, 101, 171, 126], wire(), observed(), evidence()) == [109, 5, 230, 191, 137, 108, 199, 167, 31, 144, 72, 32, 53, 220, 128, 197, 12, 150, 211, 28, 184, 199, 179, 112, 24, 51, 132, 149, 41, 211, 183, 240]);
}

#[test]
fn registered_source_and_native_facts() {
    facts::assert_source(profile(), source(), 0, [[124, 250, 141, 189, 169, 47, 46, 6, 68, 5, 73, 40, 132, 254, 145, 152, 61, 218, 136, 64, 64, 216, 34, 120, 161, 175, 73, 141, 200, 146, 37, 169], [55, 60, 117, 162, 180, 99, 157, 94, 198, 228, 152, 190, 70, 103, 167, 194, 159, 105, 208, 169, 146, 117, 85, 125, 208, 172, 74, 39, 18, 15, 209, 214]]);
    assert(facts::assert_native_facts(profile(), effect(), wire(), observed(), evidence()) == [65, 212, 186, 131, 95, 82, 245, 89, 39, 18, 171, 211, 56, 196, 165, 244, 252, 68, 202, 73, 25, 46, 194, 83, 71, 37, 190, 72, 173, 101, 171, 126]);
}

#[test(should_fail)]
fn rejects_old_profile_version() {
    let mut p = profile(); p.version = 1; facts::assert_profile(p);
}

#[test(should_fail)]
fn rejects_wrong_family() {
    let mut e = effect(); e.family = 4; let _gid = facts::assert_native_facts(profile(), e, wire(), observed(), evidence());
}

#[test(should_fail)]
fn rejects_transaction_padding() {
    let mut e = effect(); e.transaction_id[63] = 1; let _gid = facts::assert_native_facts(profile(), e, wire(), observed(), evidence());
}

#[test(should_fail)]
fn rejects_expiry_extension() {
    let mut o = observed(); o.evidence_until = 1061; let _gid = facts::assert_native_facts(profile(), effect(), wire(), o, evidence());
}

#[test(should_fail)]
fn rejects_before_inclusion() {
    let mut e = evidence(); e.finalized_block_height = 9; let _gid = facts::assert_native_facts(profile(), effect(), wire(), observed(), e);
}

#[test(should_fail)]
fn rejects_wrong_source_position() {
    facts::assert_source(profile(), source(), 1, [[124, 250, 141, 189, 169, 47, 46, 6, 68, 5, 73, 40, 132, 254, 145, 152, 61, 218, 136, 64, 64, 216, 34, 120, 161, 175, 73, 141, 200, 146, 37, 169], [55, 60, 117, 162, 180, 99, 157, 94, 198, 228, 152, 190, 70, 103, 167, 194, 159, 105, 208, 169, 146, 117, 85, 125, 208, 172, 74, 39, 18, 15, 209, 214]]);
}

