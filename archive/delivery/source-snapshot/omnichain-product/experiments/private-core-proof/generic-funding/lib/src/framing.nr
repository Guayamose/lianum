// Generated by generic-funding/generate.mjs from explicit byte contracts.
// H4 uses a u32 tag length; PC15/PC23 use their original u16 tag length.
use generic_graph::sha256::{sha256, u32_bytes, u64_bytes};

fn part<let N: u32, let M: u32>(buffer: [u8; N], offset: u32, value: [u8; M]) -> [u8; N] {
    let mut result = buffer;
    let length = u32_bytes(M);
    for i in 0..4 { result[offset + i] = length[i]; }
    for i in 0..M { result[offset + 4 + i] = value[i]; }
    result
}

// LIANUM/PAEG/reservation-intent/1; H4 u32BE tag framing.
pub fn reservation_intent(
    scope: [u8; 32],
    policy: [u8; 32],
    asset: [u8; 32],
    operation_id: [u8; 32],
    reservation_nonce: [u8; 32],
    budget: u64,
    settle_before: u64,
    recovery_commitment: [u8; 32],
    reserve_secret: [u8; 32],
) -> [u8; 32] {
    let mut message: [u8; 339] = [0; 339];
    message = part(message, 0, [76, 73, 65, 78, 85, 77, 47, 80, 65, 69, 71, 47, 114, 101, 115, 101, 114, 118, 97, 116, 105, 111, 110, 45, 105, 110, 116, 101, 110, 116, 47, 49]);
    message = part(message, 36, [76, 73, 65, 78, 85, 77, 95, 80, 65, 69, 71, 95, 70, 85, 78, 68, 69, 68, 95, 52, 95, 86, 49]);
    message = part(message, 63, scope);
    message = part(message, 99, policy);
    message = part(message, 135, asset);
    message = part(message, 171, operation_id);
    message = part(message, 207, reservation_nonce);
    message = part(message, 243, u64_bytes(budget));
    message = part(message, 255, u64_bytes(settle_before));
    message = part(message, 267, recovery_commitment);
    message = part(message, 303, reserve_secret);
    sha256::<339, 384>(message)
}

