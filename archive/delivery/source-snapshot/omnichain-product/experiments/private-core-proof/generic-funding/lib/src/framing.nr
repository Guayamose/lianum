// PC15/payment-note/1; legacy u16BE tag framing.
pub fn legacy_payment(
    scope: [u8; 32],
    origin: [u8; 32],
    kind: [u8; 1],
    key_x: [u8; 32],
    key_y: [u8; 32],
    value: u64,
    secret: [u8; 32],
) -> [u8; 32] {
    let mut message: [u8; 218] = [0; 218];
    message[0] = 0;
    message[1] = 19;
    let tag = [80, 67, 49, 53, 47, 112, 97, 121, 109, 101, 110, 116, 45, 110, 111, 116, 101, 47, 49];
    for i in 0..19 { message[2 + i] = tag[i]; }
    message = part(message, 21, scope);
    message = part(message, 57, origin);
    message = part(message, 93, kind);
    message = part(message, 98, key_x);
    message = part(message, 134, key_y);
    message = part(message, 170, u64_bytes(value));
    message = part(message, 182, secret);
    sha256::<218, 256>(message)
}

