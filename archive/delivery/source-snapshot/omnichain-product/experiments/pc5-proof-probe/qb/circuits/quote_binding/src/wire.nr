}
pub fn salt_record(salt: [u8; 32]) -> [u8; 58] {
    let mut out = [0; 58];
    let prefix: [u8; 26] = [0,20,80,67,53,45,81,66,47,114,101,115,117,108,116,45,115,97,108,116,47,49,0,0,0,32];
    for i in 0..26 { out[i] = prefix[i]; }
    for i in 0..32 { out[i + 26] = salt[i]; }
    out
}
pub fn read16<let N: u32>(bytes: [u8; N], offset: u32) -> u16 { (bytes[offset] as u16 << 8) | bytes[offset + 1] as u16 }
pub fn read64<let N: u32>(bytes: [u8; N], offset: u32) -> u64 {
    let mut value: u64 = 0;
    for i in 0..8 { value = (value << 8) | bytes[offset + i] as u64; }
    value
}
pub fn same32<let A: u32, let B: u32>(a: [u8; A], ai: u32, b: [u8; B], bi: u32) { for i in 0..32 { assert(a[ai + i] == b[bi + i]); } }
